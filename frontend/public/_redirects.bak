# ============================================================
# PRIMESHIELDHUB — Cloudflare Pages Headers Configuration
# ============================================================

# XML Sitemap — must be served as XML, not HTML
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

# Robots.txt — plain text
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# Security headers for all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()

# Fonts — long cache since they don't change
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images — long cache
/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

# CSS & JS — medium cache
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# HTML pages — short cache so updates appear quickly
/*.html
  Cache-Control: public, max-age=300

# Cloudflare Insights beacon
/cdn-cgi/*
  Cache-Control: no-store

  
# API redirect
/payroll/verify/*  https://api.primeshieldhub.com/payslips/verify/:splat  302
  

