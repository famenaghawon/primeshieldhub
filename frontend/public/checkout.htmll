<!DOCTYPE html>
<html lang="en-NG" data-theme="quantum-dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover">
    <meta name="description" content="Quantum Checkout — Secure payment gateway with Paystack integration">
    <meta name="theme-color" content="#030305">
    <title>Quantum Checkout | PrimeShieldHub</title>
    <link rel="canonical" href="https://primeshieldhub.com/checkout">
    <link rel="icon" href="/company_logo.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,200..900&family=JetBrains+Mono:ital,wght@0,200;0,400;0,700;1,200&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ================================================================ */
        /* QUANTUM CHECKOUT - ULTRA MODERN DESIGN                          */
        /* ================================================================ */

        :root {
            --bg-deep: #020203;
            --bg-primary: #050508;
            --bg-elevated: #0a0a10;
            --bg-card: #0e0e17;
            --bg-card-hover: #151520;
            --bg-input: #09090f;
            --bg-glass: rgba(14, 14, 23, 0.85);
            
            --gold-soft: #b8943e;
            --gold-core: #d4af37;
            --gold-bright: #f0d268;
            --gold-light: #fae9a0;
            
            --gold-glow-subtle: rgba(212, 175, 55, 0.04);
            --gold-glow-medium: rgba(212, 175, 55, 0.15);
            --gold-glow-strong: rgba(212, 175, 55, 0.25);
            --gold-border-subtle: rgba(212, 175, 55, 0.1);
            --gold-border: rgba(212, 175, 55, 0.22);
            --gold-border-bright: rgba(212, 175, 55, 0.4);
            
            --success: #00f0a0;
            --success-glow: rgba(0, 240, 160, 0.18);
            --warning: #ffb347;
            --danger: #ff3860;
            --danger-glow: rgba(255, 56, 96, 0.18);
            --info: #5d8aff;
            --info-glow: rgba(93, 138, 255, 0.18);
            --purple: #a855f7;
            --purple-glow: rgba(168, 85, 247, 0.18);
            --cyan: #22d3ee;
            --cyan-glow: rgba(34, 211, 238, 0.18);
            
            --text-primary: #f5f4ea;
            --text-secondary: #b8b7ad;
            --text-muted: #7a7970;
            --text-inverse: #020203;
            
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --font-serif: 'Cormorant Garamond', Georgia, serif;
            
            --radius-xs: 8px;
            --radius-sm: 14px;
            --radius-md: 20px;
            --radius-lg: 28px;
            --radius-xl: 36px;
            --radius-full: 50%;
            
            --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
            --duration-fast: 0.28s;
            --duration-medium: 0.45s;
            --duration-slow: 0.6s;
            
            --header-height: 72px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

        body {
            font-family: var(--font-sans);
            background: var(--bg-deep);
            color: var(--text-primary);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        /* ===== AMBIENT BACKGROUND ===== */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background: 
                radial-gradient(ellipse 70% 45% at 5% 0%, rgba(212, 175, 55, 0.04) 0%, transparent 60%),
                radial-gradient(ellipse 55% 35% at 95% 100%, rgba(212, 175, 55, 0.03) 0%, transparent 60%);
            pointer-events: none;
            z-index: -2;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image: 
                radial-gradient(rgba(212, 175, 55, 0.025) 1px, transparent 1px);
            background-size: 44px 44px;
            pointer-events: none;
            z-index: -1;
            mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, black 12%, transparent 70%);
            -webkit-mask-image: radial-gradient(ellipse 75% 75% at 50% 50%, black 12%, transparent 70%);
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: var(--bg-deep); }
        ::-webkit-scrollbar-thumb { background: linear-gradient(180deg, var(--gold-soft), var(--gold-bright)); border-radius: 4px; }
        ::selection { background: var(--gold-glow-strong); color: var(--text-primary); }

        /* ===== UTILITY ===== */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        .section { padding: 60px 0; }
        .gold-gradient { background: linear-gradient(135deg, var(--gold-soft), var(--gold-bright), var(--gold-light)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .flex { display: flex; }
        .flex-center { display: flex; align-items: center; justify-content: center; }
        .gap-2 { gap: 8px; }
        .gap-4 { gap: 16px; }
        .gap-6 { gap: 24px; }
        .mt-4 { margin-top: 16px; }
        .mb-4 { margin-bottom: 16px; }
        .mb-6 { margin-bottom: 24px; }
        .w-full { width: 100%; }
        .text-center { text-align: center; }
        .text-muted { color: var(--text-muted); }
        .relative { position: relative; }

        /* ================================================================ */
        /* HEADER                                                          */
        /* ================================================================ */

        .page-header {
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            background: rgba(5, 5, 8, 0.92);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            height: var(--header-height);
        }
        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
            flex-wrap: wrap;
            gap: 16px;
            height: 100%;
        }
        .header-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            filter: drop-shadow(0 0 12px var(--gold-glow-medium));
        }
        .header-brand img {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--gold-border);
            transition: transform var(--duration-fast) var(--ease-out-expo);
        }
        .header-brand:hover img { transform: scale(1.05) rotate(-2deg); }
        .header-brand-text {
            font-family: var(--font-mono);
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--text-primary);
            letter-spacing: 0.05em;
        }
        .header-brand-text span { color: var(--gold-core); }
        .header-nav {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .header-link {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.78rem;
            font-family: var(--font-mono);
            font-weight: 500;
            transition: all var(--duration-fast);
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            position: relative;
        }
        .header-link:hover,
        .header-link.active {
            color: var(--gold-core);
            background: var(--gold-glow-subtle);
        }
        .header-link.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 12px;
            right: 12px;
            height: 2px;
            background: var(--gold-core);
            border-radius: 2px;
        }

        /* ================================================================ */
        /* CHECKOUT LAYOUT                                                 */
        /* ================================================================ */

        .checkout-grid {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 32px;
            align-items: start;
        }

        /* ===== CARD STYLES ===== */
        .card-static {
            background: var(--bg-glass);
            border: 1px solid var(--gold-border-subtle);
            border-radius: var(--radius-lg);
            padding: 32px;
            backdrop-filter: blur(12px);
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.03);
            position: relative;
            overflow: hidden;
        }
        .card-static::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold-core), transparent);
            opacity: 0.3;
        }

        /* ===== FORM STYLES ===== */
        .form-group { margin-bottom: 18px; position: relative; }
        .form-label {
            display: block;
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--text-secondary);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-family: var(--font-mono);
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .form-input, .form-textarea, .form-select {
            width: 100%;
            padding: 12px 16px;
            background: var(--bg-input);
            border: 1px solid var(--gold-border-subtle);
            border-radius: var(--radius-sm);
            color: var(--text-primary);
            font-size: 0.9rem;
            outline: none;
            transition: all 0.3s var(--ease-out-expo);
            font-family: var(--font-sans);
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.4);
        }
        .form-input:focus, .form-textarea:focus, .form-select:focus {
            border-color: var(--gold-border-bright);
            box-shadow: 0 0 0 4px var(--gold-glow-subtle), 0 0 25px rgba(212, 175, 55, 0.1);
            background: #0c0c14;
        }
        .form-textarea { resize: vertical; min-height: 80px; }

        /* ===== ORDER SUMMARY ===== */
        .order-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }
        .order-item:last-child { border-bottom: none; }
        .order-item .item-name { font-size: 0.85rem; }
        .order-item .item-price { font-family: var(--font-mono); color: var(--gold-core); }
        .order-item .item-qty {
            color: var(--text-muted);
            font-size: 0.7rem;
            font-family: var(--font-mono);
        }
        .order-total {
            display: flex;
            justify-content: space-between;
            padding: 16px 0 8px;
            border-top: 2px solid var(--gold-border);
            margin-top: 8px;
        }
        .order-total .total-label {
            font-weight: 600;
            font-size: 1.1rem;
        }
        .order-total .total-amount {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--gold-core);
            font-family: var(--font-mono);
        }

        /* ================================================================ */
        /* MESSAGES                                                        */
        /* ================================================================ */

        .message {
            padding: 14px 18px;
            border-radius: var(--radius-sm);
            margin-bottom: 18px;
            display: none;
            font-size: 0.85rem;
            font-weight: 500;
            backdrop-filter: blur(10px);
            letter-spacing: 0.01em;
        }
        .message.error {
            background: var(--danger-glow);
            border: 1px solid rgba(255, 56, 96, 0.25);
            color: #ff8a9a;
            display: block;
        }
        .message.success {
            background: var(--success-glow);
            border: 1px solid rgba(0, 240, 160, 0.25);
            color: #80ffd0;
            display: block;
        }
        .message.info {
            background: var(--info-glow);
            border: 1px solid rgba(93, 138, 255, 0.25);
            color: #8ab4ff;
            display: block;
        }

        /* ================================================================ */
        /* BUTTONS                                                         */
        /* ================================================================ */

        .btn-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 32px;
            background: linear-gradient(135deg, var(--gold-soft), var(--gold-core));
            color: var(--text-inverse);
            text-decoration: none;
            border-radius: 100px;
            font-weight: 700;
            font-size: 0.9rem;
            font-family: var(--font-mono);
            transition: all 0.35s var(--ease-out-expo);
            border: none;
            cursor: pointer;
            letter-spacing: 0.03em;
            box-shadow: 0 8px 25px rgba(0,0,0,0.5);
            width: 100%;
        }
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px var(--gold-glow-medium);
            filter: brightness(1.1);
        }
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }
        .btn-primary .spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.2);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 28px;
            background: transparent;
            color: var(--gold-core);
            text-decoration: none;
            border-radius: 100px;
            font-weight: 700;
            font-size: 0.82rem;
            font-family: var(--font-mono);
            border: 1px solid var(--gold-border);
            transition: all 0.35s var(--ease-out-expo);
            cursor: pointer;
            letter-spacing: 0.03em;
        }
        .btn-secondary:hover {
            background: var(--gold-glow-subtle);
            transform: translateY(-3px);
            border-color: var(--gold-border-bright);
            box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        }

        /* ================================================================ */
        /* LOADING OVERLAY                                                 */
        /* ================================================================ */

        .loading-overlay {
            position: fixed;
            inset: 0;
            background: rgba(2, 2, 3, 0.9);
            backdrop-filter: blur(15px);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
        }
        .loading-overlay.active { display: flex; }
        .loader {
            width: 60px;
            height: 60px;
            border: 3px solid var(--gold-border-subtle);
            border-top-color: var(--gold-bright);
            border-radius: 50%;
            animation: quantumSpin 0.7s linear infinite;
            box-shadow: 0 0 30px var(--gold-glow-medium);
        }
        @keyframes quantumSpin { to { transform: rotate(360deg); } }

        /* ================================================================ */
        /* TOAST                                                           */
        /* ================================================================ */

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 10000;
            background: rgba(14, 14, 23, 0.95);
            border: 1px solid var(--gold-border);
            border-radius: var(--radius-md);
            padding: 16px 24px;
            font-family: var(--font-mono);
            font-size: 0.82rem;
            color: var(--text-primary);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(212, 175, 55, 0.1);
            transform: translateY(130px);
            opacity: 0;
            transition: all 0.4s var(--ease-out-expo);
            display: flex;
            align-items: center;
            gap: 12px;
            backdrop-filter: blur(20px);
            max-width: 400px;
        }
        .toast.show { transform: translateY(0); opacity: 1; }
        .toast.success { border-color: var(--success); box-shadow: 0 0 30px var(--success-glow); }
        .toast.error { border-color: var(--danger); box-shadow: 0 0 30px var(--danger-glow); }
        .toast.info { border-color: var(--info); box-shadow: 0 0 30px var(--info-glow); }

        /* ================================================================ */
        /* PAYMENT METHODS                                                 */
        /* ================================================================ */

        .payment-methods {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin: 16px 0;
        }
        .payment-method {
            padding: 12px;
            text-align: center;
            border: 1px solid var(--gold-border-subtle);
            border-radius: var(--radius-sm);
            background: rgba(255,255,255,0.02);
            cursor: pointer;
            transition: all 0.3s;
        }
        .payment-method:hover {
            border-color: var(--gold-border);
            background: var(--gold-glow-subtle);
        }
        .payment-method.selected {
            border-color: var(--gold-core);
            background: var(--gold-glow-medium);
        }
        .payment-method .pm-icon {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 4px;
        }
        .payment-method .pm-name {
            font-size: 0.7rem;
            color: var(--text-secondary);
            font-family: var(--font-mono);
        }

        /* ================================================================ */
        /* RESPONSIVE                                                      */
        /* ================================================================ */

        @media(max-width: 992px) {
            .checkout-grid {
                grid-template-columns: 1fr;
            }
            .payment-methods {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media(max-width: 768px) {
            .container { padding: 0 16px; }
            .section { padding: 40px 0; }
            .card-static { padding: 20px; }
            .payment-methods {
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }
            .payment-method { padding: 8px; }
            .order-total .total-amount { font-size: 1.2rem; }
            .header-nav { gap: 4px; }
            .header-link { font-size: 0.65rem; padding: 4px 8px; }
            .header-link span { display: none; }
        }

        @media(max-width: 480px) {
            .payment-methods {
                grid-template-columns: 1fr 1fr;
            }
            .order-total .total-amount { font-size: 1rem; }
            .toast {
                left: 16px;
                right: 16px;
                bottom: 16px;
                max-width: none;
                font-size: 0.75rem;
                padding: 14px 18px;
            }
        }
    </style>
</head>
<body>

<!-- ===== LOADING OVERLAY ===== -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loader"></div>
    <span style="font-family:var(--font-mono); color:var(--gold-core); font-size:0.8rem; letter-spacing:2px;">PROCESSING SECURE PAYMENT...</span>
</div>

<!-- ===== TOAST ===== -->
<div class="toast" id="toast"></div>

<!-- ===== HEADER ===== -->
<header class="page-header">
    <div class="header-inner">
        <a href="/" class="header-brand">
            <img src="/company_logo.png" alt="PrimeShieldHub">
            <span class="header-brand-text"><span>PRIME</span>SHIELDHUB</span>
        </a>
        <nav class="header-nav">
            <a href="/" class="header-link"><i class="fas fa-home"></i> <span>Home</span></a>
            <a href="/products.html" class="header-link"><i class="fas fa-box"></i> <span>Shop</span></a>
            <a href="/cart.html" class="header-link"><i class="fas fa-shopping-cart"></i> <span>Cart</span></a>
            <a href="/profile.html" class="header-link"><i class="fas fa-user-circle"></i> <span>Profile</span></a>
        </nav>
    </div>
</header>

<!-- ===== MAIN CONTENT ===== -->
<main>
    <section class="section">
        <div class="container">
            <h1 style="font-family:var(--font-serif); font-size:2.2rem; margin-bottom:32px;">
                <span class="gold-gradient">Secure Checkout</span>
            </h1>

            <div class="checkout-grid">

                <!-- ===== LEFT: BILLING DETAILS ===== -->
                <div class="card-static">
                    <h3 style="font-family:var(--font-mono); font-size:0.8rem; color:var(--gold-core); margin-bottom:20px;">
                        <i class="fas fa-address-card"></i> Billing Details
                    </h3>

                    <div class="message" id="checkoutMessage"></div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-user"></i> Full Name</label>
                        <input type="text" class="form-input" id="customerName" placeholder="Enter your full name" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-envelope"></i> Email Address</label>
                        <input type="email" class="form-input" id="customerEmail" placeholder="your@email.com" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-phone"></i> Phone Number</label>
                        <input type="tel" class="form-input" id="customerPhone" placeholder="+234 800 000 0000" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-map-marker-alt"></i> Delivery Address</label>
                        <textarea class="form-textarea" id="deliveryAddress" placeholder="Street, City, State" rows="3" required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-city"></i> City</label>
                        <input type="text" class="form-input" id="deliveryCity" placeholder="Benin City" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-map"></i> State</label>
                        <select class="form-select" id="deliveryState" required>
                            <option value="">Select State</option>
                            <option value="Abuja FCT">Abuja FCT</option>
                            <option value="Lagos">Lagos</option>
                            <option value="Rivers">Rivers</option>
                            <option value="Oyo">Oyo</option>
                            <option value="Kano">Kano</option>
                            <option value="Kaduna">Kaduna</option>
                            <option value="Edo">Edo</option>
                            <option value="Delta">Delta</option>
                            <option value="Enugu">Enugu</option>
                            <option value="Anambra">Anambra</option>
                            <option value="Imo">Imo</option>
                            <option value="Ogun">Ogun</option>
                            <option value="Kwara">Kwara</option>
                            <option value="Nasarawa">Nasarawa</option>
                            <option value="Plateau">Plateau</option>
                            <option value="Borno">Borno</option>
                            <option value="Bauchi">Bauchi</option>
                            <option value="Sokoto">Sokoto</option>
                            <option value="Kebbi">Kebbi</option>
                            <option value="Zamfara">Zamfara</option>
                            <option value="Niger">Niger</option>
                            <option value="Benue">Benue</option>
                            <option value="Taraba">Taraba</option>
                            <option value="Adamawa">Adamawa</option>
                            <option value="Yobe">Yobe</option>
                            <option value="Gombe">Gombe</option>
                            <option value="Ekiti">Ekiti</option>
                            <option value="Ondo">Ondo</option>
                            <option value="Osun">Osun</option>
                            <option value="Akwa Ibom">Akwa Ibom</option>
                            <option value="Cross River">Cross River</option>
                            <option value="Bayelsa">Bayelsa</option>
                            <option value="Ebonyi">Ebonyi</option>
                            <option value="Kogi">Kogi</option>
                            <option value="Jigawa">Jigawa</option>
                            <option value="Katsina">Katsina</option>
                        </select>
                    </div>

                    <!-- Payment Method Selection -->
                    <div style="margin: 20px 0;">
                        <label class="form-label"><i class="fas fa-credit-card"></i> Payment Method</label>
                        <div class="payment-methods">
                            <div class="payment-method selected" data-method="paystack" onclick="selectPaymentMethod(this)">
                                <span class="pm-icon">💳</span>
                                <span class="pm-name">Card</span>
                            </div>
                            <div class="payment-method" data-method="bank" onclick="selectPaymentMethod(this)">
                                <span class="pm-icon">🏦</span>
                                <span class="pm-name">Bank Transfer</span>
                            </div>
                            <div class="payment-method" data-method="whatsapp" onclick="selectPaymentMethod(this)">
                                <span class="pm-icon">💬</span>
                                <span class="pm-name">WhatsApp</span>
                            </div>
                        </div>
                        <input type="hidden" id="selectedPaymentMethod" value="paystack">
                    </div>

                    <button class="btn-primary" id="checkoutBtn">
                        <i class="fas fa-lock"></i> Place Order & Pay
                    </button>
                </div>

                <!-- ===== RIGHT: ORDER SUMMARY ===== -->
                <div class="card-static" style="position:sticky; top:calc(var(--header-height) + 20px);">
                    <h3 style="font-family:var(--font-mono); font-size:0.8rem; color:var(--gold-core); margin-bottom:20px;">
                        <i class="fas fa-shopping-bag"></i> Order Summary
                    </h3>

                    <div id="orderItems">
                        <div style="text-align:center; padding:20px; color:var(--text-muted);">
                            <i class="fas fa-spinner fa-spin"></i> Loading cart items...
                        </div>
                    </div>

                    <hr style="border-color:rgba(255,255,255,0.04); margin:16px 0;">

                    <div class="order-total">
                        <span class="total-label">Total</span>
                        <span class="total-amount" id="orderTotal">₦0.00</span>
                    </div>

                    <div style="margin-top:16px; font-size:0.7rem; color:var(--text-muted); text-align:center; font-family:var(--font-mono);">
                        <i class="fas fa-shield-alt" style="color:var(--success);"></i>
                        Secured with quantum-grade encryption
                    </div>
                </div>

            </div>
        </div>
    </section>
</main>

<!-- ===== FOOTER ===== -->
<footer style="background:var(--bg-elevated); border-top:1px solid rgba(255,255,255,0.03); padding:40px 0 20px; margin-top:auto;">
    <div class="container">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
            <div style="color:var(--text-muted); font-size:0.72rem; font-family:var(--font-mono);">
                © <span id="footerYear"></span> PrimeShieldHub Gadgets Limited. RC 9283954
            </div>
            <div style="display:flex; gap:20px;">
                <a href="/privacy.html" style="color:var(--text-muted); text-decoration:none; font-size:0.72rem; font-family:var(--font-mono);">Privacy</a>
                <a href="/terms.html" style="color:var(--text-muted); text-decoration:none; font-size:0.72rem; font-family:var(--font-mono);">Terms</a>
                <a href="/returns.html" style="color:var(--text-muted); text-decoration:none; font-size:0.72rem; font-family:var(--font-mono);">Returns</a>
            </div>
        </div>
    </div>
</footer>

<!-- ================================================================ -->
<!-- SCRIPTS - COMPLETE CHECKOUT WITH PAYMENT INTEGRATION            -->
<!-- ================================================================ -->

<script>
    (function() {
        'use strict';

        // ===== CONFIG =====
        const API_BASE = 'https://api.primeshieldhub.com/api';
        const SITE_URL = 'https://primeshieldhub.com';

        // ===== DOM REFS =====
        const loadingOverlay = document.getElementById('loadingOverlay');
        const toast = document.getElementById('toast');
        const checkoutBtn = document.getElementById('checkoutBtn');
        const checkoutMessage = document.getElementById('checkoutMessage');
        const customerName = document.getElementById('customerName');
        const customerEmail = document.getElementById('customerEmail');
        const customerPhone = document.getElementById('customerPhone');
        const deliveryAddress = document.getElementById('deliveryAddress');
        const deliveryCity = document.getElementById('deliveryCity');
        const deliveryState = document.getElementById('deliveryState');
        const orderItems = document.getElementById('orderItems');
        const orderTotal = document.getElementById('orderTotal');
        const selectedPaymentMethod = document.getElementById('selectedPaymentMethod');

        let cartItems = [];
        let cartTotal = 0;
        let isProcessing = false;

        // ===== TOAST =====
        function showToast(message, type = 'info') {
            const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle', warning: 'fa-exclamation-triangle' };
            toast.innerHTML = '<i class="fas ' + (icons[type] || icons.info) + '"></i> ' + message;
            toast.className = 'toast ' + type + ' show';
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(function() {
                toast.classList.remove('show');
            }, 4000);
        }

        function showMessage(el, msg, type = 'error') {
            if (!el) return;
            el.textContent = msg;
            el.className = 'message ' + type;
            el.style.display = 'block';
            clearTimeout(el._timeout);
            el._timeout = setTimeout(function() {
                el.style.display = 'none';
            }, 6000);
        }

        function showLoading(show) {
            loadingOverlay.classList.toggle('active', show);
        }

        function formatCurrency(amount) {
            return '₦' + Number(amount).toLocaleString('en-NG');
        }

        // ===== GET CART ITEMS =====
        function getCartItems() {
            try {
                const cart = localStorage.getItem('psh_cart') || '[]';
                return JSON.parse(cart);
            } catch (e) {
                return [];
            }
        }

        function loadCartItems() {
            cartItems = getCartItems();
            
            if (!cartItems || cartItems.length === 0) {
                orderItems.innerHTML = `
                    <div style="text-align:center; padding:20px; color:var(--text-muted);">
                        <i class="fas fa-shopping-cart" style="font-size:2rem; display:block; margin-bottom:12px;"></i>
                        Your cart is empty.
                        <br>
                        <a href="/products.html" style="color:var(--gold-core);">Continue Shopping</a>
                    </div>
                `;
                checkoutBtn.disabled = true;
                orderTotal.textContent = formatCurrency(0);
                return;
            }

            // Build order items HTML
            let html = '';
            let total = 0;

            cartItems.forEach(function(item, index) {
                const itemTotal = (item.price || 0) * (item.quantity || 1);
                total += itemTotal;
                html += `
                    <div class="order-item">
                        <div>
                            <div class="item-name">${item.name || 'Product'}</div>
                            <span class="item-qty">Qty: ${item.quantity || 1}</span>
                        </div>
                        <div class="item-price">${formatCurrency(itemTotal)}</div>
                    </div>
                `;
            });

            cartTotal = total;
            orderItems.innerHTML = html;
            orderTotal.textContent = formatCurrency(total);
            checkoutBtn.disabled = false;
        }

        // ===== PAYMENT METHOD SELECTION =====
        window.selectPaymentMethod = function(el) {
            document.querySelectorAll('.payment-method').forEach(function(m) {
                m.classList.remove('selected');
            });
            el.classList.add('selected');
            selectedPaymentMethod.value = el.dataset.method;
        };

        // ===== API CALL =====
        async function apiCall(endpoint, method = 'GET', body = null) {
            const headers = {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            };

            // Try to get auth token
            const token = localStorage.getItem('psh_auth_token');
            if (token) headers['Authorization'] = 'Bearer ' + token;

            const options = { method, headers, credentials: 'include' };
            if (body) options.body = JSON.stringify(body);

            try {
                const response = await fetch(API_BASE + endpoint, options);
                
                if (response.status === 401) {
                    // Session expired - continue as guest
                }
                
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || data.message || 'Request failed');
                return data;
            } catch (error) {
                console.error('API Error:', error);
                throw error;
            }
        }

        // ================================================================
        // ===== FIXED: CHECKOUT WITH PAYMENT =====
        // ================================================================

        checkoutBtn.addEventListener('click', async function() {
            if (isProcessing) return;

            // Validate form
            const name = customerName.value.trim();
            const email = customerEmail.value.trim();
            const phone = customerPhone.value.trim();
            const address = deliveryAddress.value.trim();
            const city = deliveryCity.value.trim();
            const state = deliveryState.value;

            if (!name) {
                showMessage(checkoutMessage, 'Please enter your full name', 'error');
                customerName.focus();
                return;
            }
            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                showMessage(checkoutMessage, 'Please enter a valid email address', 'error');
                customerEmail.focus();
                return;
            }
            if (!phone) {
                showMessage(checkoutMessage, 'Please enter your phone number', 'error');
                customerPhone.focus();
                return;
            }
            if (!address) {
                showMessage(checkoutMessage, 'Please enter your delivery address', 'error');
                deliveryAddress.focus();
                return;
            }
            if (!city) {
                showMessage(checkoutMessage, 'Please enter your city', 'error');
                deliveryCity.focus();
                return;
            }
            if (!state) {
                showMessage(checkoutMessage, 'Please select your state', 'error');
                deliveryState.focus();
                return;
            }

            // Check if cart has items
            cartItems = getCartItems();
            if (!cartItems || cartItems.length === 0) {
                showMessage(checkoutMessage, 'Your cart is empty. Please add items before checking out.', 'error');
                return;
            }

            const paymentMethod = selectedPaymentMethod.value;

            // ================================================================
            // STEP 1: Create order in database
            // ================================================================

            isProcessing = true;
            checkoutBtn.disabled = true;
            checkoutBtn.innerHTML = '<span class="spinner"></span> Processing Order...';
            showLoading(true);
            showMessage(checkoutMessage, 'Creating your order...', 'info');

            try {
                // Calculate totals
                const subtotal = cartTotal;
                const shipping_cost = subtotal > 50000 ? 0 : 3000;
                const vat = Math.round(subtotal * 0.075);
                const total = subtotal + shipping_cost + vat;

                const orderData = {
                    items: cartItems.map(item => ({
                        product_id: item.id || item.product_id || 'unknown',
                        name: item.name || 'Product',
                        quantity: item.quantity || 1,
                        price: item.price || 0
                    })),
                    subtotal: subtotal,
                    shipping_cost: shipping_cost,
                    vat: vat,
                    fee: 0,
                    total: total,
                    customerName: name,
                    customerEmail: email,
                    customerPhone: phone,
                    deliveryAddress: address,
                    city: city,
                    state: state,
                    paymentMethod: paymentMethod,
                    reference: 'ORD-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8).toUpperCase()
                };

                // Create the order
                const orderResponse = await apiCall('/orders', 'POST', orderData);

                if (!orderResponse || !orderResponse.orderId) {
                    throw new Error('Failed to create order');
                }

                const orderId = orderResponse.orderId;
                const reference = orderResponse.reference;

                // ================================================================
                // STEP 2: Process payment based on method
                // ================================================================

                if (paymentMethod === 'paystack') {
                    // Paystack - Initialize payment
                    showMessage(checkoutMessage, 'Initializing secure payment...', 'info');
                    
                    const paymentData = {
                        orderId: orderId,
                        reference: reference,
                        amount: total,
                        email: email,
                        customerName: name,
                        phone: phone
                    };

                    // Call payment initialization endpoint
                    const paymentResponse = await apiCall('/payment/simple/initiate', 'POST', paymentData);

                    if (paymentResponse && paymentResponse.authorization_url) {
                        // Redirect to Paystack payment page
                        showToast('Redirecting to payment gateway...', 'info');
                        setTimeout(function() {
                            window.location.href = paymentResponse.authorization_url;
                        }, 500);
                        return;
                    } else if (paymentResponse && paymentResponse.paymentId) {
                        // Alternative: Use inline Paystack popup (check if Paystack is loaded)
                        if (typeof PaystackPop !== 'undefined') {
                            const handler = PaystackPop.setup({
                                key: paymentResponse.publicKey || 'pk_test_...',
                                email: email,
                                amount: Math.round(total * 100), // in kobo
                                currency: 'NGN',
                                reference: reference,
                                callback: function(response) {
                                    // Verify payment
                                    verifyPayment(response.reference, orderId);
                                },
                                onClose: function() {
                                    showLoading(false);
                                    isProcessing = false;
                                    checkoutBtn.disabled = false;
                                    checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                                    showMessage(checkoutMessage, 'Payment was cancelled. You can try again.', 'warning');
                                }
                            });
                            handler.openIframe();
                            return;
                        } else {
                            // Fallback: redirect to Paystack
                            window.open('https://paystack.com/pay/primeshieldhub?ref=' + reference, '_blank');
                            showToast('Payment window opened. Complete your payment.', 'info');
                            // Don't clear cart yet - will be cleared on success
                            showLoading(false);
                            isProcessing = false;
                            checkoutBtn.disabled = false;
                            checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                            return;
                        }
                    } else {
                        throw new Error('Payment initialization failed');
                    }

                } else if (paymentMethod === 'bank') {
                    // Bank Transfer - Show bank details
                    showLoading(false);
                    isProcessing = false;
                    checkoutBtn.disabled = false;
                    checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                    
                    // Show bank transfer details
                    showMessage(checkoutMessage, 
                        '✅ Order created! Please transfer the total amount to:\n\n' +
                        'Bank: GTBank\n' +
                        'Account: 0123456789\n' +
                        'Name: PrimeShieldHub Gadgets Ltd\n' +
                        'Amount: ' + formatCurrency(total) + '\n\n' +
                        'Reference: ' + reference + '\n\n' +
                        'After payment, confirm via WhatsApp or email.',
                        'info'
                    );
                    showToast('Bank transfer details sent', 'success');
                    return;

                } else if (paymentMethod === 'whatsapp') {
                    // WhatsApp Order - Open WhatsApp with order details
                    showLoading(false);
                    isProcessing = false;
                    checkoutBtn.disabled = false;
                    checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                    
                    const message = encodeURIComponent(
                        'Hello PrimeShieldHub,\n\n' +
                        'I want to place an order:\n' +
                        'Order Reference: ' + reference + '\n' +
                        'Total: ' + formatCurrency(total) + '\n' +
                        'Name: ' + name + '\n' +
                        'Phone: ' + phone + '\n' +
                        'Address: ' + address + ', ' + city + ', ' + state + '\n\n' +
                        'Please confirm my order.'
                    );
                    
                    window.open('https://wa.me/2348103535978?text=' + message, '_blank');
                    showToast('WhatsApp opened. Complete your order via chat.', 'success');
                    return;
                }

                // ================================================================
                // STEP 3: Order placed (for non-payment methods or fallback)
                // ================================================================

                // Clear cart after successful order
                localStorage.removeItem('psh_cart');
                localStorage.removeItem('psh_cart_saved');

                showToast('Order placed successfully!', 'success');
                showMessage(checkoutMessage, '✅ Order placed successfully! You will receive a confirmation email shortly.', 'success');
                
                checkoutBtn.innerHTML = '<i class="fas fa-check-circle"></i> Order Placed!';
                checkoutBtn.disabled = true;

                // Redirect to success page after delay
                setTimeout(function() {
                    window.location.href = '/payment-success.html?ref=' + reference;
                }, 3000);

            } catch (error) {
                console.error('Checkout error:', error);
                showMessage(checkoutMessage, 'Error: ' + (error.message || 'Failed to process order'), 'error');
                showToast('Checkout failed: ' + error.message, 'error');
                isProcessing = false;
                checkoutBtn.disabled = false;
                checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                showLoading(false);
            }
        });

        // ================================================================
        // ===== VERIFY PAYMENT =====
        // ================================================================

        async function verifyPayment(reference, orderId) {
            showLoading(true);
            try {
                const response = await apiCall('/payment/verify?reference=' + reference, 'GET');
                
                if (response && response.status === 'success') {
                    // Payment successful - clear cart
                    localStorage.removeItem('psh_cart');
                    localStorage.removeItem('psh_cart_saved');
                    
                    showToast('Payment successful! 🎉', 'success');
                    showMessage(checkoutMessage, '✅ Payment verified! Your order is being processed.', 'success');
                    
                    checkoutBtn.innerHTML = '<i class="fas fa-check-circle"></i> Payment Successful!';
                    checkoutBtn.disabled = true;
                    
                    setTimeout(function() {
                        window.location.href = '/payment-success.html?ref=' + reference;
                    }, 2000);
                } else {
                    showToast('Payment verification failed. Please contact support.', 'error');
                    showMessage(checkoutMessage, 'Payment verification failed. Please contact support.', 'error');
                    isProcessing = false;
                    checkoutBtn.disabled = false;
                    checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
                    showLoading(false);
                }
            } catch (error) {
                console.error('Verification error:', error);
                showToast('Verification error: ' + error.message, 'error');
                showLoading(false);
                isProcessing = false;
                checkoutBtn.disabled = false;
                checkoutBtn.innerHTML = '<i class="fas fa-lock"></i> Place Order & Pay';
            }
        }

        // ===== PAYMENT SUCCESS HANDLER (for page redirect) =====
        if (window.location.pathname.includes('payment-success')) {
            const params = new URLSearchParams(window.location.search);
            const ref = params.get('ref') || params.get('reference') || '';
            if (ref) {
                document.addEventListener('DOMContentLoaded', function() {
                    const msgEl = document.getElementById('checkoutMessage');
                    if (msgEl) {
                        msgEl.textContent = '✅ Payment successful! Your order ' + ref + ' is being processed.';
                        msgEl.className = 'message success';
                        msgEl.style.display = 'block';
                    }
                    showToast('Payment successful! 🎉', 'success');
                });
            }
        }

        // ================================================================
        // ===== INITIALIZATION =====
        // ================================================================

        function init() {
            // Load user data if logged in
            try {
                const user = JSON.parse(localStorage.getItem('psh_user') || 'null');
                if (user) {
                    customerName.value = user.name || '';
                    customerEmail.value = user.email || '';
                    customerPhone.value = user.phone || '';
                    
                    // Load profile data
                    const profile = JSON.parse(localStorage.getItem('psh_user_profile') || '{}');
                    if (profile.address) {
                        deliveryAddress.value = profile.address;
                    }
                    if (profile.city) {
                        deliveryCity.value = profile.city;
                    }
                    if (profile.state) {
                        deliveryState.value = profile.state;
                    }
                }
            } catch (e) {}

            // Load cart items
            loadCartItems();
            
            // Set footer year
            document.getElementById('footerYear').textContent = new Date().getFullYear();

            console.log('🚀 Quantum Checkout v2.0 — Payment Integrated');
            console.log('✅ Paystack payment flow ready');
            console.log('✅ Bank transfer and WhatsApp options available');
            console.log('✅ Order creation + payment in one flow');
        }

        // ================================================================
        // ===== PAYSTACK INLINE (for popup mode) =====
        // ================================================================

        // Load Paystack script if not already loaded
        if (!document.querySelector('script[src*="paystack"]')) {
            const script = document.createElement('script');
            script.src = 'https://js.paystack.co/v1/inline.js';
            script.async = true;
            document.head.appendChild(script);
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', init);
        
        // Also init immediately if DOM already loaded
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            init();
        }

        // ===== HANDLE PAYMENT SUCCESS PAGE =====
        if (window.location.pathname.includes('payment-success') || window.location.pathname.includes('payment-success.html')) {
            const params = new URLSearchParams(window.location.search);
            const ref = params.get('ref') || params.get('reference') || '';
            const status = params.get('status') || '';
            
            if (ref) {
                document.addEventListener('DOMContentLoaded', function() {
                    const msgEl = document.getElementById('checkoutMessage');
                    if (msgEl) {
                        if (status === 'success' || status === '') {
                            msgEl.textContent = '✅ Payment successful! Your order ' + ref + ' is being processed. You will receive a confirmation email shortly.';
                            msgEl.className = 'message success';
                            msgEl.style.display = 'block';
                            showToast('Payment successful! 🎉', 'success');
                        } else {
                            msgEl.textContent = '⚠️ Payment status: ' + status + '. Please contact support for assistance.';
                            msgEl.className = 'message warning';
                            msgEl.style.display = 'block';
                        }
                    }
                });
            }
        }

        // ===== HANDLE CANCELLED PAYMENT =====
        if (window.location.search.includes('cancel=true')) {
            document.addEventListener('DOMContentLoaded', function() {
                showToast('Payment was cancelled. You can try again.', 'warning');
                const msgEl = document.getElementById('checkoutMessage');
                if (msgEl) {
                    msgEl.textContent = 'Payment was cancelled. Please try again or contact support.';
                    msgEl.className = 'message warning';
                    msgEl.style.display = 'block';
                }
            });
        }

    })();
</script>

</body>
</html>
