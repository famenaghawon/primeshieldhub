{
  "name": "PrimeShieldHub Staff Portal",
  "short_name": "Staff Hub",
  "description": "Staff portal for PrimeShieldHub - Manage orders, customers, and operations.",
  "start_url": "/staff/",
  "id": "/staff/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#030305",
  "theme_color": "#d6b25e",
  "lang": "en-NG",
  "dir": "ltr",
  "categories": ["business", "productivity", "management"],
  "icons": [
    { "src": "/staff-icons/icon-48x48.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-72x72.png", "sizes": "72x72", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-96x96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-128x128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-144x144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-152x152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-256x256.png", "sizes": "256x256", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-384x384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/staff-icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/staff-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { 
      "name": "Dashboard", 
      "url": "/staff/dashboard.html", 
      "icons": [{ "src": "/staff-icons/shortcut-dashboard.png", "sizes": "96x96" }] 
    },
    { 
      "name": "Profile", 
      "url": "/staff/profile.html", 
      "icons": [{ "src": "/staff-icons/shortcut-profile.png", "sizes": "96x96" }] 
    },
    { 
      "name": "Settings", 
      "url": "/staff/settings.html", 
      "icons": [{ "src": "/staff-icons/shortcut-settings.png", "sizes": "96x96" }] 
    },
    { 
      "name": "Activity Log", 
      "url": "/staff/activity.html", 
      "icons": [{ "src": "/staff-icons/shortcut-activity.png", "sizes": "96x96" }] 
    }
  ],
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "launch_handler": { 
    "client_mode": ["navigate-existing", "auto"] 
  },
  "scope": "/staff/",
  "serviceworker": {
    "src": "/sw.js",
    "scope": "/"
  },
  "note": "This is the staff portal PWA. Main site manifest is at /quantum-manifest.json"
}
