<!DOCTYPE html>
<html lang="en" data-quantum-version="9.0.0">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="description" content="PrimeShieldHub Payment Gateway">
  <title>PrimeShieldHub | Payment</title>
  
  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&family=Orbitron:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Paystack Inline Script -->
  <script src="https://js.paystack.co/v1/inline.js"></script>
  
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg-deep: #010105;
      --surface-dark: rgba(8, 12, 25, 0.85);
      --glass-edge: rgba(0, 247, 255, 0.25);
      --neon-cyan: #00f7ff;
      --neon-gold: #ffd966;
      --accent-success: #33ffaa;
      --accent-danger: #ff3366;
      --text-primary: #f0f3ff;
      --text-secondary: #9ca3cf;
      --gradient-primary: linear-gradient(135deg, #00f7ff, #b200ff);
      --gradient-gold: linear-gradient(135deg, #ffd966, #ffaa33);
      --shadow-glow: 0 0 20px rgba(0,247,255,0.3);
      --radius-card: 2rem;
      --transition-smooth: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    body {
      font-family: 'Inter', 'Space Grotesk', sans-serif;
      background: var(--bg-deep);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      position: relative;
    }

    /* Background Grid */
    .quantum-grid-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0,247,255,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,247,255,0.05) 1px, transparent 1px);
      background-size: 50px 50px;
      z-index: -1;
      animation: gridShift 20s linear infinite;
    }

    @keyframes gridShift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(50px, 50px); }
    }

    .payment-card {
      background: var(--surface-dark);
      backdrop-filter: blur(20px);
      border-radius: var(--radius-card);
      border: 1px solid var(--glass-edge);
      padding: 2.5rem;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
      animation: floatIn 0.6s ease-out;
    }

    @keyframes floatIn {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .payment-icon {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--gradient-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2.5rem;
      color: white;
      box-shadow: var(--shadow-glow);
    }

    .payment-title {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      background: var(--gradient-gold);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .payment-subtitle {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .order-details {
      background: rgba(0,0,0,0.3);
      border-radius: 1rem;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .order-details .row {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .order-details .row:last-child {
      border-bottom: none;
    }

    .order-details .label {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    .order-details .value {
      font-weight: 600;
      font-size: 0.95rem;
      word-break: break-all;
      max-width: 60%;
      text-align: right;
    }

    .order-details .value.amount {
      color: var(--neon-cyan);
      font-size: 1.2rem;
    }

    .quantum-btn {
      width: 100%;
      padding: 1rem;
      background: var(--gradient-primary);
      border: none;
      border-radius: 2rem;
      font-weight: 700;
      font-size: 1rem;
      color: white;
      cursor: pointer;
      transition: var(--transition-smooth);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }

    .quantum-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 0 30px rgba(0,247,255,0.4);
    }

    .quantum-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .quantum-btn .spinner {
      display: inline-block;
      width: 20px;
      height: 20px;
      border: 2px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: #fff;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .back-link {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      transition: var(--transition-smooth);
    }

    .back-link:hover {
      color: var(--neon-cyan);
    }

    .error-message {
      color: var(--accent-danger);
      font-size: 0.9rem;
      margin-top: 1rem;
      padding: 0.8rem;
      background: rgba(255,51,102,0.1);
      border-radius: 0.5rem;
      border: 1px solid rgba(255,51,102,0.2);
      display: none;
    }

    .error-message.show {
      display: block;
    }

    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: var(--surface-dark);
      backdrop-filter: blur(20px);
      border: 1px solid var(--neon-cyan);
      border-radius: 2rem;
      padding: 1rem 2rem;
      color: var(--neon-cyan);
      z-index: 10000;
      animation: slideIn 0.3s ease;
      display: none;
      max-width: 400px;
    }

    .toast.error {
      border-color: var(--accent-danger);
      color: var(--accent-danger);
    }

    .toast.success {
      border-color: var(--accent-success);
      color: var(--accent-success);
    }

    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    /* Guest badge */
    .guest-badge {
      display: inline-block;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 2rem;
      padding: 0.3rem 1rem;
      font-size: 0.7rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    @media (max-width: 480px) {
      .payment-card {
        padding: 1.5rem;
      }
      .payment-title {
        font-size: 1.4rem;
      }
    }
  </style>
</head>
<body>
  <div class="quantum-grid-overlay"></div>

  <div class="payment-card">
    <div class="payment-icon">
      <i class="fas fa-bolt"></i>
    </div>
    
    <h1 class="payment-title">Complete Payment</h1>
    <p class="payment-subtitle">Secure payment via Paystack</p>

    <div class="guest-badge">
      <i class="fas fa-user"></i> Guest Checkout
    </div>

    <div class="order-details" id="orderDetails">
      <div class="row">
        <span class="label">Order Reference</span>
        <span class="value" id="orderRef">---</span>
      </div>
      <div class="row">
        <span class="label">Customer</span>
        <span class="value" id="customerName">---</span>
      </div>
      <div class="row">
        <span class="label">Email</span>
        <span class="value" id="customerEmail">---</span>
      </div>
      <div class="row" style="margin-top: 0.5rem; padding-top: 0.5rem; border-top: 2px solid var(--glass-edge);">
        <span class="label" style="font-weight: 700;">Amount</span>
        <span class="value amount" id="amount">₦0</span>
      </div>
    </div>

    <button class="quantum-btn" id="payBtn">
      <i class="fas fa-lock"></i>
      <span id="payBtnText">Pay Now</span>
    </button>

    <div class="error-message" id="errorMessage">
      <i class="fas fa-exclamation-circle"></i> <span id="errorText">Payment failed</span>
    </div>

    <a href="/checkout.html" class="back-link">
      <i class="fas fa-arrow-left"></i> Return to Checkout
    </a>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    // ================================================================
    // CONFIGURATION
    // ================================================================
    const API_BASE = 'https://api.primeshieldhub.com/api';
    
    // IMPORTANT: Use your actual Paystack public key
    // For testing, use test key. For production, use live key.
    const PAYSTACK_KEY = 'pk_test_...'; // ← CHANGE THIS to your actual key

    // ================================================================
    // GET PARAMS FROM URL
    // ================================================================
    const urlParams = new URLSearchParams(window.location.search);
    const reference = urlParams.get('reference');
    const amount = urlParams.get('amount');
    const email = urlParams.get('email') || '';
    const name = urlParams.get('name') || 'Guest Customer';

    // ================================================================
    // DOM REFS
    // ================================================================
    const orderRef = document.getElementById('orderRef');
    const customerName = document.getElementById('customerName');
    const customerEmail = document.getElementById('customerEmail');
    const amountDisplay = document.getElementById('amount');
    const payBtn = document.getElementById('payBtn');
    const payBtnText = document.getElementById('payBtnText');
    const errorMessage = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    const toast = document.getElementById('toast');

    let toastTimeout = null;
    let paymentHandler = null;

    // ================================================================
    // TOAST SYSTEM
    // ================================================================
    function showToast(message, type = 'info') {
      if (toastTimeout) {
        clearTimeout(toastTimeout);
        toast.style.display = 'none';
      }
      toast.textContent = message;
      toast.className = 'toast ' + type;
      toast.style.display = 'block';
      toastTimeout = setTimeout(() => {
        toast.style.display = 'none';
        toastTimeout = null;
      }, 4000);
    }

    // ================================================================
    // DISPLAY ORDER DETAILS
    // ================================================================
    function displayOrderDetails() {
      orderRef.textContent = reference || '---';
      customerName.textContent = name || '---';
      customerEmail.textContent = email || '---';
      const amountNum = parseFloat(amount) || 0;
      amountDisplay.textContent = `₦${amountNum.toLocaleString()}`;
    }

    // ================================================================
    // SHOW/HIDE ERROR
    // ================================================================
    function showError(message) {
      errorText.textContent = message;
      errorMessage.classList.add('show');
    }

    function hideError() {
      errorMessage.classList.remove('show');
    }

    // ================================================================
    // SET LOADING STATE
    // ================================================================
    function setLoading(loading, text = 'Opening Paystack...') {
      if (loading) {
        payBtn.disabled = true;
        payBtnText.innerHTML = `<span class="spinner"></span> ${text}`;
      } else {
        payBtn.disabled = false;
        payBtnText.textContent = 'Pay Now';
      }
    }

    // ================================================================
    // PAYSTACK CALLBACK FUNCTIONS (DEFINED SEPARATELY)
    // ================================================================
    
    // This function is called when payment is successful
    function handlePaystackSuccess(response) {
      console.log('✅ Paystack success:', response);
      showToast('Payment successful! Verifying...', 'success');
      
      setLoading(true, 'Verifying payment...');
      
      // Verify payment with backend
      fetch(`${API_BASE}/payment/verify?reference=${response.reference}`)
        .then(res => res.json())
        .then(data => {
          console.log('Verification response:', data);
          if (data.success) {
            showToast('✅ Payment verified!', 'success');
            setTimeout(() => {
              window.location.href = `/payment-success?reference=${response.reference}`;
            }, 1500);
          } else {
            showToast('⚠️ Payment verification failed. Contact support.', 'error');
            setLoading(false);
          }
        })
        .catch(err => {
          console.error('Verification error:', err);
          showToast('⚠️ Verification failed. Contact support.', 'error');
          setLoading(false);
        });
    }

    // This function is called when payment is cancelled
    function handlePaystackCancel() {
      console.log('❌ Paystack cancelled');
      setLoading(false);
      showToast('Payment cancelled.', 'info');
    }

    // ================================================================
    // INITIATE PAYSTACK PAYMENT - FIXED VERSION
    // ================================================================
    function initiatePaystackPayment() {
      // Validate required data
      if (!reference) {
        showError('No order reference found. Please try again.');
        return;
      }

      if (!amount || parseFloat(amount) <= 0) {
        showError('Invalid amount. Please try again.');
        return;
      }

      if (!email || !email.includes('@')) {
        showError('Valid email is required for payment.');
        return;
      }

      hideError();
      setLoading(true, 'Initializing Paystack...');

      const amountInKobo = Math.round(parseFloat(amount) * 100);
      
      // Make sure amount is at least 100 kobo (Paystack minimum)
      if (amountInKobo < 100) {
        showError('Minimum payment amount is ₦1.00');
        setLoading(false);
        return;
      }

      console.log('🔑 Paystack Key:', PAYSTACK_KEY);
      console.log('💰 Amount (kobo):', amountInKobo);
      console.log('📧 Email:', email);
      console.log('📋 Reference:', reference);

      try {
        // ===== FIX: Define callback functions correctly =====
        // The callback MUST be a function, not an object
        const paymentConfig = {
          key: PAYSTACK_KEY,
          email: email,
          amount: amountInKobo,
          currency: 'NGN',
          ref: reference,
          metadata: {
            custom_fields: [
              { display_name: "Customer Name", variable_name: "name", value: name },
              { display_name: "Order Reference", variable_name: "order_ref", value: reference }
            ]
          },
          // These MUST be functions
          callback: handlePaystackSuccess,
          onClose: handlePaystackCancel
        };

        console.log('📦 Paystack config:', paymentConfig);

        paymentHandler = PaystackPop.setup(paymentConfig);
        paymentHandler.openIframe();

      } catch (error) {
        console.error('❌ Paystack error:', error);
        setLoading(false);
        showError('Payment initialization failed: ' + error.message);
      }
    }

    // ================================================================
    // EVENT LISTENERS
    // ================================================================
    payBtn.addEventListener('click', function(e) {
      e.preventDefault();
      initiatePaystackPayment();
    });

    // ================================================================
    // INIT
    // ================================================================
    displayOrderDetails();

    // Check if all required data is present
    if (!reference || !amount || !email) {
      showError('Invalid payment data. Please go back and try again.');
    } else {
      // Auto-initiate payment after short delay
      setTimeout(function() {
        initiatePaystackPayment();
      }, 1000);
    }

    console.log('🚀 Payment Gateway v2.1 — No Firebase, Guest Checkout Ready');
    console.log(`📋 Reference: ${reference}`);
    console.log(`💰 Amount: ₦${amount}`);
    console.log(`👤 Customer: ${name} (${email})`);
    console.log(`🔑 Paystack Key: ${PAYSTACK_KEY.substring(0, 10)}...`);
  </script>
</body>
</html>
