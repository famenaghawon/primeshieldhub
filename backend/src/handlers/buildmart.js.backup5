// ===== CART =====
export async function handleBuildMartGetCart(request, env, ctx, corsHeaders) {
  try {
    const fingerprint = request.headers.get('x-device-fingerprint') || 'guest';

    const cart = await env.DB.prepare(`
      SELECT c.*, p.name as product_name, p.price as current_price, p.image_url
      FROM cart_items c
      JOIN products p ON c.product_id = p.id
      WHERE c.fingerprint = ? AND c.type = 'cart'
    `).bind(fingerprint).all();

    let subtotal = 0;
    const items = (cart.results || []).map(item => {
      const total = item.quantity * (item.current_price || item.price || 0);
      subtotal += total;
      return { ...item, total };
    });

    const delivery = subtotal > 1000000 ? 0 : 25000;
    const vat = (subtotal + delivery) * 0.075;
    const grandTotal = subtotal + delivery + vat;

    return new Response(JSON.stringify({
      success: true,
      data: {
        items,
        subtotal,
        delivery,
        vat,
        grand_total: grandTotal
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartAddToCart(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { product_id, quantity } = body || {};
    const fingerprint = request.headers.get('x-device-fingerprint') || 'guest';

    if (!product_id) {
      return new Response(JSON.stringify({ error: "Product ID is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const product = await env.DB.prepare(
      "SELECT name, price FROM products WHERE id = ?"
    ).bind(product_id).first();

    if (!product) {
      return new Response(JSON.stringify({ error: "Product not found" }), {
        status: 404,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const existing = await env.DB.prepare(
      "SELECT id, quantity FROM cart_items WHERE fingerprint = ? AND product_id = ? AND type = 'cart'"
    ).bind(fingerprint, product_id).first();

    if (existing) {
      await env.DB.prepare(
        "UPDATE cart_items SET quantity = quantity + ?, updated_at = datetime('now') WHERE id = ?"
      ).bind(quantity || 1, existing.id).run();
    } else {
      const id = crypto.randomUUID();
      await env.DB.prepare(`
        INSERT INTO cart_items (id, fingerprint, product_id, quantity, type, created_at)
        VALUES (?, ?, ?, ?, 'cart', datetime('now'))
      `).bind(id, fingerprint, product_id, quantity || 1).run();
    }

    return new Response(JSON.stringify({
      success: true,
      message: "Item added to cart"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartUpdateCartItem(request, env, ctx, corsHeaders) {
  try {
    const itemId = request.url.split('/')[5];
    const body = await request.json();
    const { quantity } = body || {};
    const fingerprint = request.headers.get('x-device-fingerprint') || 'guest';

    if (!quantity || quantity < 1) {
      return new Response(JSON.stringify({ error: "Valid quantity is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    await env.DB.prepare(
      "UPDATE cart_items SET quantity = ?, updated_at = datetime('now') WHERE id = ? AND fingerprint = ?"
    ).bind(quantity, itemId, fingerprint).run();

    return new Response(JSON.stringify({
      success: true,
      message: "Cart updated"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

