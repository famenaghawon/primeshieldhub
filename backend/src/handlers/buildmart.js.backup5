export async function handleBuildMartBrandStats(request, env, ctx, corsHeaders) {
  try {
    const stats = await env.DB.prepare(`
      SELECT 
        (SELECT COUNT(*) FROM construction_projects) as projects,
        (SELECT COUNT(*) FROM contractors) as contractors,
        (SELECT COUNT(DISTINCT state) FROM delivery_regions) as states,
        (SELECT COUNT(*) FROM products WHERE category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')) as products,
        (SELECT COALESCE(SUM(budget), 0) FROM construction_projects) as total_value,
        (SELECT AVG(rating) FROM contractors WHERE rating > 0) as avg_rating
    `).first();

    return new Response(JSON.stringify({
      success: true,
      data: stats || {
        projects: 0,
        contractors: 0,
        states: 0,
        products: 0,
        total_value: 0,
        avg_rating: 0
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartBrandAsk(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { question } = body || {};

    if (!question) {
      return new Response(JSON.stringify({ error: "Question is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Simple response based on keywords
    let response = "Thank you for your question. Our team is available to assist you with any construction procurement needs.";
    
    if (question.toLowerCase().includes('cement')) {
      response = "We offer premium cement from Dangote, BUA, and Lafarge. Prices start from ₦10,500 per 50kg bag. Bulk discounts available for orders over 500 bags.";
    } else if (question.toLowerCase().includes('steel')) {
      response = "We provide high-quality steel reinforcement bars in various sizes (10mm, 12mm, 16mm). Prices range from ₦450,000 to ₦650,000 per ton depending on grade and quantity.";
    } else if (question.toLowerCase().includes('delivery')) {
      response = "We offer delivery services across Nigeria with 99.2% on-time delivery rate. Delivery costs are calculated based on location, weight, and priority level.";
    } else if (question.toLowerCase().includes('contractor')) {
      response = "We work with verified contractors across Nigeria. You can find and connect with contractors based on location, specialization, and rating on our platform.";
    }

    return new Response(JSON.stringify({
      success: true,
      response,
      question
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

