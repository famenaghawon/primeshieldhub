export async function handleBuildMartSearchContractors(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const q = url.searchParams.get('q') || '';
    const location = url.searchParams.get('location') || '';
    const rating = parseFloat(url.searchParams.get('rating')) || 0;

    let query = `
      SELECT id, company_name, location, rating, years_in_business, project_types, avatar
      FROM contractors 
      WHERE status = 'active'
    `;
    const params = [];

    if (q) {
      query += ` AND (company_name LIKE ? OR specialization LIKE ?)`;
      const searchPattern = `%${q}%`;
      params.push(searchPattern, searchPattern);
    }

    if (location) {
      query += ` AND location LIKE ?`;
      params.push(`%${location}%`);
    }

    if (rating > 0) {
      query += ` AND rating >= ?`;
      params.push(rating);
    }

    query += ` ORDER BY rating DESC LIMIT 20`;

    const result = await env.DB.prepare(query).bind(...params).all();

    return new Response(JSON.stringify({
      success: true,
      contractors: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartSearchCalculators(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const q = url.searchParams.get('q') || '';

    // Return available calculators
    const calculators = [
      { id: 'concrete', name: 'Concrete Calculator', description: 'Calculate concrete volume and materials' },
      { id: 'steel', name: 'Steel Weight Calculator', description: 'Calculate steel weight and quantity' },
      { id: 'paint', name: 'Paint Coverage Calculator', description: 'Calculate paint needed for walls' },
      { id: 'roofing', name: 'Roofing Material Calculator', description: 'Calculate roofing materials needed' },
      { id: 'tile', name: 'Tile Calculator', description: 'Calculate tiles needed for flooring' }
    ];

    let filtered = calculators;
    if (q) {
      const searchLower = q.toLowerCase();
      filtered = calculators.filter(c => 
        c.name.toLowerCase().includes(searchLower) || 
        c.description.toLowerCase().includes(searchLower)
      );
    }

    return new Response(JSON.stringify({
      success: true,
      calculators: filtered
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

