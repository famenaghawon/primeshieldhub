export async function handleBuildMartKnowledgeGraph(request, env, ctx, corsHeaders) {
  try {
    const nodes = await env.DB.prepare(`
      SELECT id, title as label, category
      FROM knowledge_articles
      LIMIT 20
    `).all();

    const edges = [];
    for (let i = 0; i < (nodes.results || []).length; i++) {
      for (let j = i + 1; j < (nodes.results || []).length; j++) {
        if (nodes.results[i].category === nodes.results[j].category) {
          edges.push({
            source: nodes.results[i].id,
            target: nodes.results[j].id,
            type: 'related'
          });
        }
      }
    }

    return new Response(JSON.stringify({
      success: true,
      data: {
        nodes: nodes.results || [],
        edges: edges.slice(0, 30)
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartFeedback(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { article_id, helpful } = body || {};

    if (!article_id) {
      return new Response(JSON.stringify({ error: "Article ID is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    await env.DB.prepare(`
      INSERT INTO knowledge_feedback (id, article_id, helpful, created_at)
      VALUES (?, ?, ?, datetime('now'))
    `).bind(crypto.randomUUID(), article_id, helpful ? 1 : 0).run();

    // Update article helpful rate
    const stats = await env.DB.prepare(`
      SELECT COUNT(*) as total, SUM(helpful) as helpful_count
      FROM knowledge_feedback
      WHERE article_id = ?
    `).bind(article_id).first();

    if (stats && stats.total > 0) {
      const rate = (stats.helpful_count / stats.total) * 100;
      await env.DB.prepare(
        "UPDATE knowledge_articles SET helpful_rate = ?, helpful_count = ? WHERE id = ?"
      ).bind(rate, stats.helpful_count, article_id).run();
    }

    return new Response(JSON.stringify({
      success: true,
      message: "Feedback recorded"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartKnowledgeSearch(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { query } = body || {};

    if (!query || query.length < 2) {
      return new Response(JSON.stringify({ error: "Query must be at least 2 characters" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const searchPattern = `%${query}%`;
    const result = await env.DB.prepare(`
      SELECT id, title, excerpt, category, helpful_count,
             CASE 
               WHEN title LIKE ? THEN 3
               WHEN category LIKE ? THEN 2
               ELSE 1
             END as relevance
      FROM knowledge_articles
      WHERE title LIKE ? OR content LIKE ? OR category LIKE ?
      ORDER BY relevance DESC, helpful_count DESC
      LIMIT 10
    `).bind(searchPattern, searchPattern, searchPattern, searchPattern, searchPattern).all();

    // Log search
    await env.DB.prepare(`
      INSERT INTO knowledge_queries (id, query, result_count, created_at)
      VALUES (?, ?, ?, datetime('now'))
    `).bind(crypto.randomUUID(), query, (result.results || []).length).run();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

