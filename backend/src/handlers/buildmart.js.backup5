// ===== BULK ORDERS =====
export async function handleBuildMartCreateBulkOrder(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { items, delivery_address, scheduled_date, special_requirements } = body || {};

    if (!items || !Array.isArray(items) || items.length === 0) {
      return new Response(JSON.stringify({ error: "Items are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    let totalCost = 0;

    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT price FROM products WHERE id = ?"
      ).bind(item.product_id).first();
      
      if (product) {
        const quantity = parseInt(item.quantity) || 1;
        totalCost += product.price * quantity;
      }
    }

    // Apply bulk discount (10% for bulk orders)
    const savings = totalCost * 0.1;
    const finalTotal = totalCost - savings;

    await env.DB.prepare(`
      INSERT INTO bulk_orders (id, items, delivery_address, scheduled_date, special_requirements, total_cost, savings, final_total, status, created_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'pending', datetime('now'))
    `).bind(
      id, JSON.stringify(items), delivery_address || '', scheduled_date || '',
      special_requirements || '', totalCost, savings, finalTotal
    ).run();

    // Add bulk items
    for (const item of items) {
      await env.DB.prepare(`
        INSERT INTO bulk_order_items (id, bulk_order_id, product_id, quantity, unit_price, total)
        VALUES (?, ?, ?, ?, ?, ?)
      `).bind(
        crypto.randomUUID(), id, item.product_id, parseInt(item.quantity) || 1,
        item.price || 0, (item.price || 0) * (parseInt(item.quantity) || 1)
      ).run();
    }

    return new Response(JSON.stringify({
      success: true,
      order_id: id,
      status: 'pending',
      estimated_delivery: scheduled_date || 'Pending',
      total_cost: finalTotal,
      savings: savings
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

