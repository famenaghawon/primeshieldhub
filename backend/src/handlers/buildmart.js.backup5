export async function handleBuildMartWholesalePricing(request, env, ctx, corsHeaders) {
  try {
    // Simple bulk pricing calculation
    const result = await env.DB.prepare(`
      SELECT id, name, price, 
             ROUND(price * 0.95, 2) as price_50_100,
             ROUND(price * 0.90, 2) as price_100_500,
             ROUND(price * 0.85, 2) as price_500_1000,
             ROUND(price * 0.80, 2) as price_1000_plus
      FROM products 
      WHERE category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')
      LIMIT 20
    `).all();

    return new Response(JSON.stringify({
      success: true,
      products: result.results || []
    }), {
