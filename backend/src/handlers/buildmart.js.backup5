export async function handleBuildMartCompanySearch(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const q = url.searchParams.get('q') || '';

    if (!q || q.length < 2) {
      return new Response(JSON.stringify({ error: "Search query must be at least 2 characters" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Search in contractors and inquiries
    const contractors = await env.DB.prepare(`
      SELECT company_name as name, cac_number, address, 'contractor' as type
      FROM contractors 
      WHERE company_name LIKE ? OR cac_number LIKE ?
      LIMIT 10
    `).bind(`%${q}%`, `%${q}%`).all();

    return new Response(JSON.stringify({
      success: true,
      found: (contractors.results || []).length > 0,
      data: contractors.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartDocumentUpload(request, env, ctx, corsHeaders) {
  try {
    const formData = await request.formData();
    const files = formData.getAll('documents');

    if (!files || files.length === 0) {
      return new Response(JSON.stringify({ error: "No documents uploaded" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const uploaded = [];
    for (const file of files) {
      if (file.size > 0) {
        const key = `documents/${Date.now()}-${crypto.randomUUID()}-${file.name}`;
        await env.STORAGE.put(key, file.stream(), {
          httpMetadata: {
            contentType: file.type || 'application/octet-stream',
            contentDisposition: `attachment; filename="${file.name}"`
          }
        });

        uploaded.push({
          id: crypto.randomUUID(),
          name: file.name,
          size: file.size,
          type: file.type,
          url: `${SITE_URL}/files/${key}`,
          uploaded_at: new Date().toISOString()
        });
      }
    }

    return new Response(JSON.stringify({
      success: true,
      documents: uploaded,
      message: `${uploaded.length} files uploaded successfully`
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== AI BUILD MART =====
export async function handleBuildMartAIEstimate(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { query, project_type, location } = body || {};

    if (!query && !project_type) {
      return new Response(JSON.stringify({ error: "Query or project type is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const queryLower = (query || '').toLowerCase();
    let detectedType = project_type || 'residential';
    let estimatedArea = 150;

    if (queryLower.includes('commercial') || queryLower.includes('office')) {
      detectedType = 'commercial';
      estimatedArea = 500;
    } else if (queryLower.includes('industrial') || queryLower.includes('warehouse')) {
      detectedType = 'industrial';
      estimatedArea = 1000;
    } else if (queryLower.includes('duplex') || queryLower.includes('4-bedroom')) {
      estimatedArea = 200;
    } else if (queryLower.includes('bungalow') || queryLower.includes('3-bedroom')) {
      estimatedArea = 150;
    }

    const suggestions = [
      {
        id: 'dangote-cement-50kg',
        name: 'Dangote Cement 50kg',
        quantity: Math.ceil(estimatedArea * 3.5),
        price: 10800,
        brand: 'Dangote',
        category: 'cement',
        total: Math.ceil(estimatedArea * 3.5) * 10800
      },
      {
        id: 'dulux-emulsion-20l',
        name: 'Dulux Emulsion Paint 20L',
        quantity: Math.ceil(estimatedArea * 0.4),
        price: 28000,
        brand: 'Dulux',
        category: 'paints',
        total: Math.ceil(estimatedArea * 0.4) * 28000
      }
    ];

    let subtotal = suggestions.reduce((sum, item) => sum + item.total, 0);
    const discount = subtotal * 0.05;
    const vat = (subtotal - discount) * 0.075;
    const delivery = 35000;

    return new Response(JSON.stringify({
      success: true,
      project_type: detectedType,
      project_size: 'medium',
      estimated_area: estimatedArea,
      suggestions,
      summary: {
        subtotal,
        discount,
        discount_rate: 5,
        vat,
        delivery,
        grand_total: subtotal - discount + vat + delivery
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

