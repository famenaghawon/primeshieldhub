export async function handleBuildMartContactSubmit(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { name, email, phone, subject, message } = body || {};

    if (!name || !email || !message) {
      return new Response(JSON.stringify({ error: "Name, email, and message are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    await env.DB.prepare(`
      INSERT INTO contact_messages (id, name, email, phone, subject, message, status, created_at)
      VALUES (?, ?, ?, ?, ?, ?, 'pending', datetime('now'))
    `).bind(id, name, email, phone || '', subject || '', message).run();

    return new Response(JSON.stringify({
      success: true,
      id,
      message: "Message sent successfully"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartCreateInquiry(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const {
      name, company, phone, email, project_type, urgency,
      state, city, address, category, budget, quantity,
      date, communication, materials
    } = body || {};

    if (!name || !email || !project_type) {
      return new Response(JSON.stringify({ error: "Name, email, and project type are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    await env.DB.prepare(`
      INSERT INTO inquiries (
        id, name, company, phone, email, project_type, urgency,
        state, city, address, category, budget, quantity,
        date, communication, materials, status, created_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', datetime('now'))
    `).bind(
      id, name, company || '', phone || '', email, project_type,
      urgency || 'normal', state || '', city || '', address || '',
      category || '', budget || 0, quantity || '',
      date || '', communication || 'email', JSON.stringify(materials || [])
    ).run();

    return new Response(JSON.stringify({
      success: true,
      id,
      status: 'pending'
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartSiteVisit(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { inquiry_id, date, time, notes } = body || {};

    if (!inquiry_id || !date || !time) {
      return new Response(JSON.stringify({ error: "Inquiry ID, date, and time are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    await env.DB.prepare(`
      INSERT INTO site_visits (id, inquiry_id, date, time, notes, status, created_at)
      VALUES (?, ?, ?, ?, ?, 'scheduled', datetime('now'))
    `).bind(id, inquiry_id, date, time, notes || '').run();

    await env.DB.prepare(
      "UPDATE inquiries SET status = 'site_visit_scheduled' WHERE id = ?"
    ).bind(inquiry_id).run();

    return new Response(JSON.stringify({
      success: true,
      visit_id: id,
      status: 'scheduled'
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartWorkspace(request, env, ctx, corsHeaders) {
  try {
    const inquiryId = request.url.split('/')[4];

    const inquiry = await env.DB.prepare(`
      SELECT * FROM inquiries WHERE id = ?
    `).bind(inquiryId).first();

    if (!inquiry) {
      return new Response(JSON.stringify({ error: "Inquiry not found" }), {
        status: 404,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const messages = await env.DB.prepare(`
      SELECT * FROM workspace_messages WHERE inquiry_id = ? ORDER BY created_at ASC
    `).bind(inquiryId).all();

    return new Response(JSON.stringify({
      success: true,
      data: {
        inquiry,
        messages: messages.results || []
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

