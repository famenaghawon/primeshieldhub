export async function handleBuildMartBOQUpload(request, env, ctx, corsHeaders) {
  try {
    const formData = await request.formData();
    const file = formData.get('file');

    if (!file) {
      return new Response(JSON.stringify({ error: "No file uploaded" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Extract text from file (simplified for now)
    const text = await file.text();

    // Simple parsing of BOQ data
    const materials = [];
    const lines = text.split('\n').filter(line => line.trim());
    
    for (const line of lines) {
      // Try to extract material name, quantity, unit
      const parts = line.split(/\s{2,}|\t|,/).filter(p => p.trim());
      if (parts.length >= 2) {
        const name = parts[0].trim();
        const quantity = parseFloat(parts[1]) || 0;
        const unit = parts[2]?.trim() || 'pcs';
        materials.push({ name, quantity, unit });
      }
    }

    // Estimate cost
    const estimatedCost = materials.length * 50000;

    return new Response(JSON.stringify({
      success: true,
      data: {
        materials: materials.slice(0, 20),
        estimated_cost: estimatedCost,
        suppliers: [
          { name: 'Dangote Distributor', location: 'Lagos', rating: 4.9 },
          { name: 'BUA Supplier', location: 'Abuja', rating: 4.8 }
        ],
        delivery_plan: {
          days: '2-3',
          priority: 'Standard',
          cost: Math.round(estimatedCost * 0.05)
        }
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

