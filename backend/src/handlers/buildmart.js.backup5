// ===== COMPARE PRODUCTS =====
export async function handleBuildMartCompareProducts(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { product_ids } = body || {};

    if (!product_ids || !Array.isArray(product_ids) || product_ids.length < 2) {
      return new Response(JSON.stringify({ 
        error: "At least 2 product IDs are required for comparison" 
      }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const placeholders = product_ids.map(() => '?').join(',');
    const query = `
      SELECT p.*, c.name as category_name, c.icon as category_icon
      FROM products p
      LEFT JOIN categories c ON p.category = c.id
      WHERE p.id IN (${placeholders})
    `;

    const result = await env.DB.prepare(query).bind(...product_ids).all();

    if (!result.results || result.results.length < 2) {
      return new Response(JSON.stringify({ 
        error: "Not enough products found for comparison" 
      }), {
        status: 404,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const products = result.results || [];
    const comparison = {
      products: products,
      metrics: {
        price_range: {
          min: Math.min(...products.map(p => p.price || 0)),
          max: Math.max(...products.map(p => p.price || 0)),
          average: products.reduce((sum, p) => sum + (p.price || 0), 0) / products.length
        },
        stock_status: products.map(p => ({
          id: p.id,
          name: p.name,
          in_stock: (p.stock || 0) > 0,
          stock_level: (p.stock || 0) > 50 ? 'high' : (p.stock || 0) > 10 ? 'medium' : 'low'
        }))
      }
    };

    return new Response(JSON.stringify({
      success: true,
      data: comparison
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== BULK ORDER =====
export async function handleBuildMartBulkOrder(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { items, delivery_address, scheduled_date, special_requirements, customer_info } = body || {};

    if (!items || !Array.isArray(items) || items.length === 0) {
      return new Response(JSON.stringify({ error: "Items are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    const orderNumber = `BULK-${Date.now().toString().slice(-6)}`;
    let totalCost = 0;
    const bulkItems = [];
    let totalQuantity = 0;

    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT id, name, price, stock FROM products WHERE id = ?"
      ).bind(item.product_id).first();
      
      if (product) {
        const quantity = parseInt(item.quantity) || 1;
        const itemTotal = product.price * quantity;
        totalCost += itemTotal;
        totalQuantity += quantity;
        bulkItems.push({
          product_id: product.id,
          product_name: product.name,
          quantity,
          unit_price: product.price,
          total: itemTotal
        });

        if (product.stock < quantity) {
          return new Response(JSON.stringify({ 
            error: `Insufficient stock for ${product.name}. Available: ${product.stock}, Requested: ${quantity}` 
          }), {
            status: 400,
            headers: { "Content-Type": "application/json", ...corsHeaders }
          });
        }
      }
    }

    let discountRate = 0;
    if (totalQuantity >= 1000) discountRate = 15;
    else if (totalQuantity >= 500) discountRate = 12;
    else if (totalQuantity >= 100) discountRate = 10;
    else if (totalQuantity >= 50) discountRate = 7;
    else if (totalQuantity >= 25) discountRate = 5;

    const savings = totalCost * (discountRate / 100);
    const finalTotal = totalCost - savings;

    let estimatedDays = '3-5 business days';
    if (totalQuantity > 500) estimatedDays = '5-7 business days';
    else if (totalQuantity > 100) estimatedDays = '4-6 business days';

    await env.DB.prepare(`
      INSERT INTO bulk_orders (
        id, order_number, items, delivery_address, scheduled_date, 
        special_requirements, total_cost, savings, discount_rate,
        final_total, total_quantity, status, estimated_delivery, created_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, datetime('now'))
    `).bind(
      id, orderNumber, JSON.stringify(bulkItems), delivery_address || '', 
      scheduled_date || '', special_requirements || '', totalCost, 
      savings, discountRate, finalTotal, totalQuantity, estimatedDays
    ).run();

    return new Response(JSON.stringify({
      success: true,
      order_id: id,
      order_number: orderNumber,
      status: 'pending',
      total_items: bulkItems.length,
      total_quantity: totalQuantity,
      estimated_delivery: estimatedDays,
      discount_rate: discountRate,
      savings: savings,
      total_cost: finalTotal,
      message: "Bulk order created successfully."
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== CHECKOUT =====
export async function handleBuildMartCheckout(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { 
      items, customer_name, customer_email, customer_phone, 
      delivery_address, delivery_region, delivery_zone,
      payment_method, notes, discount_code, company_name,
      require_invoice, delivery_instructions
    } = body || {};

    if (!items || !Array.isArray(items) || items.length === 0) {
      return new Response(JSON.stringify({ error: "Items are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    if (!customer_name || !customer_email || !delivery_address) {
      return new Response(JSON.stringify({ 
        error: "Customer name, email, and delivery address are required" 
      }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const orderId = crypto.randomUUID();
    const orderNumber = `ORD-${Date.now().toString().slice(-6)}`;
    let subtotal = 0;
    const orderItems = [];
    const stockErrors = [];

    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT id, name, price, stock FROM products WHERE id = ?"
      ).bind(item.product_id).first();
      
      if (!product) {
        stockErrors.push(`Product ID ${item.product_id} not found`);
        continue;
      }

      const quantity = parseInt(item.quantity) || 1;
      
      if (product.stock < quantity) {
        stockErrors.push(`Insufficient stock for ${product.name}. Available: ${product.stock}, Requested: ${quantity}`);
        continue;
      }

      const itemTotal = product.price * quantity;
      subtotal += itemTotal;
      orderItems.push({
        product_id: product.id,
        product_name: product.name,
        quantity,
        unit_price: product.price,
        total: itemTotal
      });
    }

    if (stockErrors.length > 0) {
      return new Response(JSON.stringify({ 
        error: "Stock issues detected",
        details: stockErrors 
      }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    if (orderItems.length === 0) {
      return new Response(JSON.stringify({ 
        error: "No valid items to checkout" 
      }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    let discountRate = 0;
    let discountCodeId = null;
    if (discount_code) {
      const code = await env.DB.prepare(
        "SELECT id, discount_percent FROM wholesale_codes WHERE code = ? AND is_active = 1 AND (max_uses IS NULL OR times_used < max_uses)"
      ).bind(discount_code).first();
      if (code) {
        discountRate = code.discount_percent || 0;
        discountCodeId = code.id;
        await env.DB.prepare(
          "UPDATE wholesale_codes SET times_used = times_used + 1 WHERE id = ?"
        ).bind(code.id).run();
      }
    }

    const discount = subtotal * (discountRate / 100);
    const afterDiscount = subtotal - discount;

    let deliveryCost = 25000;
    let deliveryEstimate = '3-5 business days';
    
    if (delivery_region) {
      const region = await env.DB.prepare(
        "SELECT name, base_price, estimated_days FROM delivery_regions WHERE id = ? AND status = 'active'"
      ).bind(delivery_region).first();
      if (region) {
        deliveryCost = region.base_price || 25000;
        deliveryEstimate = region.estimated_days || '3-5 business days';
        
        if (delivery_zone) {
          const zone = await env.DB.prepare(
            "SELECT price FROM delivery_zones WHERE id = ? AND region_id = ? AND status = 'active'"
          ).bind(delivery_zone, delivery_region).first();
          if (zone?.price) {
            deliveryCost = zone.price;
          }
        }
      }
    }

    if (subtotal >= 1000000) {
      deliveryCost = 0;
    }

    const vat = (afterDiscount + deliveryCost) * 0.075;
    const grandTotal = afterDiscount + deliveryCost + vat;

    for (const item of orderItems) {
      await env.DB.prepare(
        "UPDATE products SET stock = stock - ? WHERE id = ?"
      ).bind(item.quantity, item.product_id).run();
    }

    await env.DB.prepare(`
      INSERT INTO orders (
        id, order_number, customer_name, customer_email, customer_phone,
        delivery_address, delivery_region, delivery_zone, items, subtotal, 
        discount, discount_rate, discount_code_id, delivery_cost, vat, 
        grand_total, payment_method, company_name, require_invoice,
        delivery_instructions, status, notes, created_at, updated_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?, datetime('now'), datetime('now'))
    `).bind(
      orderId, orderNumber, customer_name, customer_email, customer_phone || '',
      delivery_address, delivery_region || '', delivery_zone || '', 
      JSON.stringify(orderItems), subtotal, discount, discountRate, 
      discountCodeId, deliveryCost, vat, grandTotal,
      payment_method || 'bank_transfer', company_name || '',
      require_invoice ? 1 : 0, delivery_instructions || '', notes || ''
    ).run();

    let paymentReference = null;
    let paymentLink = null;

    if (payment_method === 'paystack' || payment_method === 'card') {
      paymentReference = `PAY-${Date.now().toString().slice(-6)}${Math.random().toString(36).substring(2, 6).toUpperCase()}`;
      paymentLink = `${SITE_URL}/payment/${orderId}`;
    }

    return new Response(JSON.stringify({
      success: true,
      order_id: orderId,
      order_number: orderNumber,
      status: 'pending',
      payment_method: payment_method || 'bank_transfer',
      payment_reference: paymentReference,
      payment_link: paymentLink,
      delivery_estimate: deliveryEstimate,
      totals: {
        subtotal,
        discount,
        discount_rate: discountRate,
        delivery: deliveryCost,
        vat,
        grand_total: grandTotal
      },
      items: orderItems,
      message: "Order created successfully!"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== HELPER FUNCTIONS =====
async function recalculateQuoteTotals(env, quoteId) {
  const items = await env.DB.prepare(
    "SELECT SUM(total) as subtotal FROM quote_items WHERE quote_id = ?"
  ).bind(quoteId).first();

  const subtotal = items?.subtotal || 0;
  const discount = subtotal * 0.05;
  const delivery = 35000;
  const vat = (subtotal - discount + delivery) * 0.075;
  const grandTotal = subtotal - discount + delivery + vat;

  await env.DB.prepare(`
    UPDATE quotes 
    SET subtotal = ?, discount = ?, discount_rate = 5,
        delivery_cost = ?, vat = ?, grand_total = ?
    WHERE id = ?
  `).bind(subtotal, discount, delivery, vat, grandTotal, quoteId).run();
}
