export async function handleBuildMartCartToQuote(request, env, ctx, corsHeaders) {
  try {
    const fingerprint = request.headers.get('x-device-fingerprint') || 'guest';

    const cart = await env.DB.prepare(`
      SELECT c.*, p.name as product_name, p.price
      FROM cart_items c
      JOIN products p ON c.product_id = p.id
      WHERE c.fingerprint = ? AND c.type = 'cart'
    `).bind(fingerprint).all();

    if (!cart.results || cart.results.length === 0) {
      return new Response(JSON.stringify({ error: "Cart is empty" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const quoteId = crypto.randomUUID();
    const quoteNumber = `QTE-${Date.now().toString().slice(-6)}`;

    let subtotal = 0;
    for (const item of cart.results) {
      subtotal += item.quantity * item.price;
    }

    await env.DB.prepare(`
      INSERT INTO quotes (id, quote_number, subtotal, grand_total, status, created_at)
      VALUES (?, ?, ?, ?, 'draft', datetime('now'))
    `).bind(quoteId, quoteNumber, subtotal, subtotal).run();

    for (const item of cart.results) {
      await env.DB.prepare(`
        INSERT INTO quote_items (id, quote_id, product_id, product_name, quantity, unit_price, total)
        VALUES (?, ?, ?, ?, ?, ?, ?)
      `).bind(crypto.randomUUID(), quoteId, item.product_id, item.product_name, item.quantity, item.price, item.quantity * item.price).run();
    }

    return new Response(JSON.stringify({
      success: true,
      quote_id: quoteId,
      quote_number: quoteNumber
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

