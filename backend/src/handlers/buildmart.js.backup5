}

// ===== SEARCH =====
export async function handleBuildMartGlobalSearch(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const q = url.searchParams.get('q') || '';

    if (!q || q.length < 2) {
      return new Response(JSON.stringify({
        success: true,
        data: { products: [], knowledge: [], contractors: [], calculators: [] }
      }), { headers: { "Content-Type": "application/json", ...corsHeaders } });
    }

    const searchPattern = `%${q}%`;

    // Products
    const products = await env.DB.prepare(`
      SELECT id, name, price, brand, category, stock, image_url,
             'product' as type
      FROM products 
      WHERE name LIKE ? OR brand LIKE ? OR description LIKE ?
      LIMIT 10
    `).bind(searchPattern, searchPattern, searchPattern).all();

    // Knowledge articles
    const knowledge = await env.DB.prepare(`
      SELECT id, title, excerpt, category,
             'knowledge' as type
      FROM knowledge_articles 
      WHERE title LIKE ? OR content LIKE ? OR category LIKE ?
      LIMIT 5
    `).bind(searchPattern, searchPattern, searchPattern).all();

    // Contractors
    const contractors = await env.DB.prepare(`
      SELECT id, company_name, location, rating, years_in_business,
             'contractor' as type
      FROM contractors 
      WHERE company_name LIKE ? OR location LIKE ? OR specialization LIKE ?
      LIMIT 5
    `).bind(searchPattern, searchPattern, searchPattern).all();

    return new Response(JSON.stringify({
      success: true,
      data: {
        products: products.results || [],
        knowledge: knowledge.results || [],
        contractors: contractors.results || [],
        calculators: []
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartSearchSuggestions(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const q = url.searchParams.get('q') || '';

    if (!q || q.length < 1) {
      return new Response(JSON.stringify({ success: true, data: [] }), {
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const searchPattern = `%${q}%`;

    const products = await env.DB.prepare(`
      SELECT name, 'product' as type
      FROM products 
      WHERE name LIKE ? 
      LIMIT 5
    `).bind(searchPattern).all();

    const knowledge = await env.DB.prepare(`
      SELECT title, 'knowledge' as type
      FROM knowledge_articles 
      WHERE title LIKE ? 
      LIMIT 3
    `).bind(searchPattern).all();

    const contractors = await env.DB.prepare(`
      SELECT company_name, 'contractor' as type
      FROM contractors 
      WHERE company_name LIKE ? 
      LIMIT 3
    `).bind(searchPattern).all();

    const suggestions = [
      ...(products.results || []).map(r => ({ name: r.name, type: r.type })),
      ...(knowledge.results || []).map(r => ({ name: r.title, type: r.type })),
      ...(contractors.results || []).map(r => ({ name: r.company_name, type: r.type }))
    ];

    return new Response(JSON.stringify({
      success: true,
      data: suggestions.slice(0, 10)
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartTrendingSearches(request, env, ctx, corsHeaders) {
  try {
    const result = await env.DB.prepare(`
      SELECT search_term, COUNT(*) as count
      FROM search_logs
      WHERE created_at > datetime('now', '-7 days')
      GROUP BY search_term
      ORDER BY count DESC
      LIMIT 10
    `).all();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartRecentSearches(request, env, ctx, corsHeaders) {
  try {
    const fingerprint = request.headers.get('x-device-fingerprint') || 'unknown';

    const result = await env.DB.prepare(`
      SELECT search_term, created_at
      FROM search_logs
      WHERE fingerprint = ?
      ORDER BY created_at DESC
