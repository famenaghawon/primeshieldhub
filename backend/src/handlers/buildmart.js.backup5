export async function handleBuildMartCalculateDelivery(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { pickup, destination, weight, priority } = body || {};

    if (!pickup || !destination) {
      return new Response(JSON.stringify({ error: "Pickup and destination are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Mock calculation
    const distance = Math.floor(Math.random() * 300) + 50;
    const baseFee = 2000;
    const perKm = 150;
    const weightSurcharge = weight ? Math.ceil(weight / 1000) * 500 : 0;
    const prioritySurcharge = priority === 'express' ? 5000 : 0;

    const totalFee = baseFee + (distance * perKm) + weightSurcharge + prioritySurcharge;

    return new Response(JSON.stringify({
      success: true,
      truck: weight > 5000 ? '20 Ton' : weight > 2000 ? '10 Ton' : '5 Ton',
      time: `${Math.ceil(distance / 60)} hrs`,
      fee: `₦${totalFee.toLocaleString()}`,
      carbon: totalFee > 50000 ? 'Medium' : 'Low',
      route: `${pickup} → ${destination}`
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

