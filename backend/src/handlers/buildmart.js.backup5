export async function handleBuildMartGetContractors(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const location = url.searchParams.get('location') || '';
    const rating = parseFloat(url.searchParams.get('rating')) || 0;
    const specialization = url.searchParams.get('specialization') || '';

    let query = "SELECT * FROM contractors WHERE status = 'active'";
    const params = [];

    if (location) {
      query += ` AND address LIKE ?`;
      params.push(`%${location}%`);
    }

    if (rating > 0) {
      query += ` AND rating >= ?`;
      params.push(rating);
    }

    if (specialization) {
      query += ` AND project_types LIKE ?`;
      params.push(`%${specialization}%`);
    }

    query += ` ORDER BY rating DESC LIMIT 50`;

    const result = await env.DB.prepare(query).bind(...params).all();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

