export async function handleBuildMartMoveToCart(request, env, ctx, corsHeaders) {
  try {
    const itemId = request.url.split('/')[5];
    const fingerprint = request.headers.get('x-device-fingerprint') || 'guest';

    const wishItem = await env.DB.prepare(
      "SELECT product_id FROM wishlist WHERE id = ? AND fingerprint = ?"
    ).bind(itemId, fingerprint).first();

    if (!wishItem) {
      return new Response(JSON.stringify({ error: "Item not found in wishlist" }), {
        status: 404,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Add to cart
    const existing = await env.DB.prepare(
      "SELECT id FROM cart_items WHERE fingerprint = ? AND product_id = ? AND type = 'cart'"
    ).bind(fingerprint, wishItem.product_id).first();

    if (existing) {
      await env.DB.prepare(
        "UPDATE cart_items SET quantity = quantity + 1 WHERE id = ?"
      ).bind(existing.id).run();
    } else {
      const id = crypto.randomUUID();
      await env.DB.prepare(`
        INSERT INTO cart_items (id, fingerprint, product_id, quantity, type, created_at)
        VALUES (?, ?, ?, 1, 'cart', datetime('now'))
      `).bind(id, fingerprint, wishItem.product_id).run();
    }

    // Remove from wishlist
    await env.DB.prepare(
      "DELETE FROM wishlist WHERE id = ?"
    ).bind(itemId).run();

    return new Response(JSON.stringify({
      success: true,
      message: "Moved to cart"
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== KNOWLEDGE BASE =====
export async function handleBuildMartKnowledgeStats(request, env, ctx, corsHeaders) {
  try {
    const stats = await env.DB.prepare(`
      SELECT 
        (SELECT COUNT(*) FROM knowledge_articles) as total_articles,
        (SELECT COUNT(*) FROM knowledge_queries) as total_queries,
        (SELECT COALESCE(AVG(response_time), 0) FROM knowledge_queries WHERE response_time IS NOT NULL) as avg_response,
        (SELECT COALESCE(AVG(helpful_rate), 0) FROM knowledge_articles) as accuracy
    `).first();

    return new Response(JSON.stringify({
      success: true,
      data: stats || { total_articles: 0, total_queries: 0, avg_response: 0, accuracy: 0 }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartKnowledgeCategories(request, env, ctx, corsHeaders) {
  try {
    const result = await env.DB.prepare(`
      SELECT category, COUNT(*) as article_count,
             MAX(updated_at) as updated,
             AVG(helpful_rate) as helpfulness
      FROM knowledge_articles
      GROUP BY category
      ORDER BY article_count DESC
    `).all();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartKnowledgeArticles(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const category = url.searchParams.get('category') || '';
    const page = parseInt(url.searchParams.get('page')) || 1;
    const limit = parseInt(url.searchParams.get('limit')) || 20;

    let query = "SELECT * FROM knowledge_articles WHERE 1=1";
    const params = [];

    if (category) {
      query += ` AND category = ?`;
      params.push(category);
    }

    const offset = (page - 1) * limit;
    query += ` ORDER BY helpful_count DESC LIMIT ? OFFSET ?`;
    params.push(limit, offset);

    const result = await env.DB.prepare(query).bind(...params).all();

    const total = await env.DB.prepare(
      "SELECT COUNT(*) as total FROM knowledge_articles" + (category ? " WHERE category = ?" : "")
    ).bind(...(category ? [category] : [])).first();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || [],
      pagination: {
        total: total?.total || 0,
        page,
        limit,
        pages: Math.ceil((total?.total || 0) / limit)
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartKnowledgeArticle(request, env, ctx, corsHeaders) {
  try {
    const id = request.url.split('/')[5];

    const article = await env.DB.prepare(`
      SELECT * FROM knowledge_articles WHERE id = ?
