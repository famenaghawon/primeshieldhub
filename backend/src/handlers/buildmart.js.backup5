// ===== QUOTES =====
export async function handleBuildMartCreateQuote(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const {
      customer_name, customer_email, customer_phone, company_name,
      project_name, project_type, delivery_region, delivery_zone,
      delivery_date, discount_code, notes, items
    } = body || {};

    if (!customer_name || !items || !Array.isArray(items) || items.length === 0) {
      return new Response(JSON.stringify({ error: "Customer name and items are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    const id = crypto.randomUUID();
    const quoteNumber = `QTE-${Date.now().toString().slice(-6)}`;

    // Calculate subtotal
    let subtotal = 0;
    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT price FROM products WHERE id = ?"
      ).bind(item.product_id).first();
      
      if (product) {
        const price = product.price;
        const quantity = parseInt(item.quantity) || 1;
        subtotal += price * quantity;
      }
    }

    // Apply discount
    let discountRate = 0;
    if (discount_code) {
      const code = await env.DB.prepare(
        "SELECT discount_percent FROM wholesale_codes WHERE code = ? AND is_active = 1"
      ).bind(discount_code).first();
      if (code) {
        discountRate = code.discount_percent || 0;
      }
    }

    const discount = subtotal * (discountRate / 100);
    const afterDiscount = subtotal - discount;

    // Calculate delivery
    let deliveryCost = 0;
    if (delivery_region) {
      const region = await env.DB.prepare(
        "SELECT base_price FROM delivery_regions WHERE id = ?"
      ).bind(delivery_region).first();
      deliveryCost = region?.base_price || 0;
    }

    const vat = (afterDiscount + deliveryCost) * 0.075;
    const grandTotal = afterDiscount + deliveryCost + vat;

    await env.DB.prepare(`
      INSERT INTO quotes (
        id, quote_number, customer_name, customer_email, customer_phone,
        company_name, project_name, project_type, delivery_region, delivery_zone,
        delivery_date, discount_code, notes, subtotal, discount, discount_rate,
        delivery_cost, vat, grand_total, status, created_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'draft', datetime('now'))
    `).bind(
      id, quoteNumber, customer_name, customer_email, customer_phone,
      company_name, project_name, project_type, delivery_region, delivery_zone,
      delivery_date, discount_code, notes, subtotal, discount, discountRate,
      deliveryCost, vat, grandTotal
    ).run();

    // Add items
    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT name, price FROM products WHERE id = ?"
      ).bind(item.product_id).first();

      if (product) {
        const quantity = parseInt(item.quantity) || 1;
        const unitPrice = product.price;
        const totalPrice = unitPrice * quantity;

        await env.DB.prepare(`
          INSERT INTO quote_items (id, quote_id, product_id, product_name, quantity, unit_price, total, notes)
          VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          crypto.randomUUID(), id, item.product_id, product.name,
          quantity, unitPrice, totalPrice, item.notes || ''
        ).run();
      }
    }

    return new Response(JSON.stringify({
      success: true,
      id,
      quote_number: quoteNumber,
      status: 'draft',
      totals: { subtotal, discount, discount_rate: discountRate, delivery: deliveryCost, vat, grand_total: grandTotal }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartCalculateQuote(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { items, region_id, zone_id, discount_code } = body || {};

    if (!items || !Array.isArray(items) || items.length === 0) {
      return new Response(JSON.stringify({ error: "Items are required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    let subtotal = 0;
    const processedItems = [];

    for (const item of items) {
      const product = await env.DB.prepare(
        "SELECT id, name, price FROM products WHERE id = ?"
      ).bind(item.product_id).first();

      if (!product) {
        return new Response(JSON.stringify({ error: `Product ${item.product_id} not found` }), {
          status: 404,
          headers: { "Content-Type": "application/json", ...corsHeaders }
        });
      }

      const quantity = parseInt(item.quantity) || 1;
      const total = product.price * quantity;
      subtotal += total;

      processedItems.push({
        product_id: product.id,
        product_name: product.name,
        quantity,
        unit_price: product.price,
        total
      });
    }

    // Discount
    let discountRate = 0;
    if (subtotal >= 2000000) discountRate = 10;
    else if (subtotal >= 1000000) discountRate = 7;
    else if (subtotal >= 500000) discountRate = 5;

    if (discount_code) {
      const code = await env.DB.prepare(
        "SELECT discount_percent FROM wholesale_codes WHERE code = ? AND is_active = 1"
      ).bind(discount_code).first();
      if (code) {
        discountRate = code.discount_percent || discountRate;
      }
    }

    const discount = subtotal * (discountRate / 100);
    const afterDiscount = subtotal - discount;

    // Delivery
    let deliveryCost = 0;
    if (region_id) {
      const region = await env.DB.prepare(
        "SELECT base_price FROM delivery_regions WHERE id = ?"
      ).bind(region_id).first();
      deliveryCost = region?.base_price || 0;

      if (zone_id) {
        const zone = await env.DB.prepare(
          "SELECT price FROM delivery_zones WHERE id = ? AND region_id = ?"
        ).bind(zone_id, region_id).first();
        if (zone?.price) deliveryCost = zone.price;
      }

      // Free delivery threshold
      if (subtotal >= 1000000) {
        deliveryCost = 0;
      }
    }

    const vat = (afterDiscount + deliveryCost) * 0.075;
    const grandTotal = afterDiscount + deliveryCost + vat;

    return new Response(JSON.stringify({
      success: true,
      subtotal,
      discount,
      discount_rate: discountRate,
      after_discount: afterDiscount,
      delivery: deliveryCost,
      vat,
      grand_total: grandTotal,
      items: processedItems,
      breakdown: {
        subtotal_formatted: `₦${subtotal.toLocaleString()}`,
        discount_formatted: `-₦${discount.toLocaleString()}`,
        delivery_formatted: `₦${deliveryCost.toLocaleString()}`,
        vat_formatted: `₦${vat.toLocaleString()}`,
        grand_total_formatted: `₦${grandTotal.toLocaleString()}`
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartGetQuote(request, env, ctx, corsHeaders) {
  try {
    const id = request.url.split('/')[4];

    const quote = await env.DB.prepare(`
      SELECT * FROM quotes WHERE id = ?
