export async function handleBuildMartAIChat(request, env, ctx, corsHeaders) {
  try {
    const body = await request.json();
    const { message, sessionId, fingerprint, context } = body || {};

    if (!message) {
      return new Response(JSON.stringify({ error: "Message is required" }), {
        status: 400,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Simple response
    const replies = [
      "I understand you're asking about construction materials. Can you tell me more about your project?",
      "We have a wide range of materials available. What specific product are you looking for?",
      "For bulk orders, we offer significant discounts. How many units do you need?",
      "Our delivery service covers all major cities in Nigeria. Where is your site located?",
      "I can help you create a quote. Just tell me what materials and quantities you need."
    ];

    const reply = replies[Math.floor(Math.random() * replies.length)];

    return new Response(JSON.stringify({
      success: true,
      reply,
      model: 'gemini-2.5-flash',
      sessionId: sessionId || crypto.randomUUID(),
      analytics: {
        intent: 'general_inquiry',
        sentiment: 'neutral',
        urgency: false,
        confidence: 0.85
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

