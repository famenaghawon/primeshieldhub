// ===== DASHBOARD & STATS =====
export async function handleBuildMartDashboard(request, env, ctx, corsHeaders) {
  try {
    const result = await env.DB.prepare(`
      SELECT 
        (SELECT COUNT(*) FROM products WHERE category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')) as total_products,
        (SELECT COUNT(*) FROM customers) as total_customers,
        (SELECT COUNT(*) FROM construction_projects WHERE status = 'active') as active_projects,
        (SELECT COUNT(DISTINCT state) FROM delivery_regions) as states_covered,
        (SELECT COUNT(*) FROM delivery_vehicles WHERE status = 'active') as active_trucks,
        (SELECT COALESCE(SUM(budget), 0) FROM construction_projects) as total_value,
        (SELECT COUNT(*) FROM staff WHERE role = 'procurement') as procurement_staff,
        (SELECT COUNT(*) FROM warehouses WHERE status = 'active') as warehouse_count
    `).first();

    return new Response(JSON.stringify({
      success: true,
      data: result || {
        total_products: 0,
        total_customers: 0,
        active_projects: 0,
        states_covered: 0,
        active_trucks: 0,
        total_value: 0,
        procurement_staff: 0,
        warehouse_count: 0
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartDashboardStats(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const period = url.searchParams.get('period') || 'week';

    let dateFilter = "datetime('now', '-7 days')";
    if (period === 'month') dateFilter = "datetime('now', '-30 days')";
    else if (period === 'day') dateFilter = "datetime('now', '-1 day')";

    const result = await env.DB.prepare(`
      SELECT 
        date(created_at) as date,
        COUNT(*) as orders,
        COALESCE(SUM(total), 0) as revenue
      FROM orders
      WHERE created_at > ${dateFilter}
      GROUP BY date(created_at)
      ORDER BY date ASC
    `).all();

    return new Response(JSON.stringify({
      success: true,
      data: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartPublicStats(request, env, ctx, corsHeaders) {
  try {
    const stats = await env.DB.prepare(`
      SELECT 
        (SELECT COUNT(*) FROM construction_projects WHERE status = 'active') as active_projects,
        (SELECT COUNT(*) FROM contractors WHERE status = 'active') as active_contractors,
        (SELECT COUNT(*) FROM products WHERE category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')) as total_products,
        (SELECT COUNT(DISTINCT state) FROM delivery_regions) as states_covered
    `).first();

    return new Response(JSON.stringify({
      success: true,
      data: stats || {
        active_projects: 0,
        active_contractors: 0,
        total_products: 0,
        states_covered: 0
      }
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== PRODUCTS =====
export async function handleBuildMartProducts(request, env, ctx, corsHeaders) {
  try {
    const url = new URL(request.url);
    const search = url.searchParams.get('search') || '';
    const category = url.searchParams.get('category') || '';
    const brand = url.searchParams.get('brand') || '';
    const minPrice = parseFloat(url.searchParams.get('minPrice')) || 0;
    const maxPrice = parseFloat(url.searchParams.get('maxPrice')) || 999999999;
    const stock = url.searchParams.get('stock') || 'all';
    const featured = url.searchParams.get('featured') || '';
    const limit = parseInt(url.searchParams.get('limit')) || 20;
    const offset = parseInt(url.searchParams.get('offset')) || 0;

    let query = `
      SELECT p.*, c.name as category_name, c.icon as category_icon
      FROM products p
      LEFT JOIN categories c ON p.category = c.id
      WHERE p.category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')
    `;
    const params = [];

    if (search) {
      query += ` AND (p.name LIKE ? OR p.brand LIKE ? OR p.description LIKE ?)`;
      const searchPattern = `%${search}%`;
      params.push(searchPattern, searchPattern, searchPattern);
    }

    if (category) {
      query += ` AND p.category = ?`;
      params.push(category);
    }

    if (brand) {
      query += ` AND p.brand = ?`;
      params.push(brand);
    }

    if (minPrice > 0) {
      query += ` AND p.price >= ?`;
      params.push(minPrice);
    }

    if (maxPrice < 999999999) {
      query += ` AND p.price <= ?`;
      params.push(maxPrice);
    }

    if (stock === 'in') {
      query += ` AND p.stock > 0`;
    } else if (stock === 'out') {
      query += ` AND p.stock = 0`;
    } else if (stock === 'low') {
      query += ` AND p.stock > 0 AND p.stock < 10`;
    }

    if (featured === 'true') {
      query += ` AND p.featured = 1`;
    }

    query += ` ORDER BY p.name ASC LIMIT ? OFFSET ?`;
    params.push(limit, offset);

    const result = await env.DB.prepare(query).bind(...params).all();

    // Get total count
    let countQuery = `
      SELECT COUNT(*) as total 
      FROM products p
      WHERE p.category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')
    `;
    const countParams = [];

    if (search) {
      countQuery += ` AND (p.name LIKE ? OR p.brand LIKE ? OR p.description LIKE ?)`;
      countParams.push(`%${search}%`, `%${search}%`, `%${search}%`);
    }
    if (category) {
      countQuery += ` AND p.category = ?`;
      countParams.push(category);
    }
    if (brand) {
      countQuery += ` AND p.brand = ?`;
      countParams.push(brand);
    }
    if (minPrice > 0) {
      countQuery += ` AND p.price >= ?`;
      countParams.push(minPrice);
    }
    if (maxPrice < 999999999) {
      countQuery += ` AND p.price <= ?`;
      countParams.push(maxPrice);
    }

    const total = await env.DB.prepare(countQuery).bind(...countParams).first();

    return new Response(JSON.stringify({
      success: true,
      products: result.results || [],
      total: total?.total || 0,
      limit,
      offset
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartProductDetail(request, env, ctx, corsHeaders) {
  try {
    const id = request.url.split('/')[4];
    
    const product = await env.DB.prepare(`
      SELECT p.*, c.name as category_name, c.icon as category_icon
      FROM products p
      LEFT JOIN categories c ON p.category = c.id
      WHERE p.id = ?
    `).bind(id).first();

    if (!product) {
      return new Response(JSON.stringify({ error: "Product not found" }), {
        status: 404,
        headers: { "Content-Type": "application/json", ...corsHeaders }
      });
    }

    // Get related products
    const related = await env.DB.prepare(`
      SELECT * FROM products 
      WHERE category = ? AND id != ? 
      LIMIT 4
    `).bind(product.category, id).all();

    return new Response(JSON.stringify({
      success: true,
      product,
      related: related.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

export async function handleBuildMartFeaturedProducts(request, env, ctx, corsHeaders) {
  try {
    const result = await env.DB.prepare(`
      SELECT * FROM products 
      WHERE featured = 1 AND category IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')
      ORDER BY RANDOM()
      LIMIT 6
    `).all();

    return new Response(JSON.stringify({
      success: true,
      products: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

// ===== CATEGORIES =====
export async function handleBuildMartCategories(request, env, ctx, corsHeaders) {
  try {
    const result = await env.DB.prepare(`
      SELECT c.*, 
             (SELECT COUNT(*) FROM products WHERE category = c.id) as product_count,
             (SELECT COUNT(DISTINCT brand) FROM products WHERE category = c.id) as brand_count,
             (SELECT COALESCE(MIN(price), 0) FROM products WHERE category = c.id) as min_price,
             (SELECT COALESCE(MAX(price), 0) FROM products WHERE category = c.id) as max_price
      FROM categories c
      WHERE c.id IN ('cement','roofing','paints','plumbing','electrical','timber','tools','hardware','tiles','gas-cylinders','steel','insulation','windows','sanitary','aggregates')
      ORDER BY c.display_order ASC
    `).all();

    return new Response(JSON.stringify({
      success: true,
      categories: result.results || []
    }), {
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  } catch (e) {
    return new Response(JSON.stringify({ error: e.message }), {
      status: 500,
      headers: { "Content-Type": "application/json", ...corsHeaders }
    });
  }
}

