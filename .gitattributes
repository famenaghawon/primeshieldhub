# Normalize line endings — avoids CRLF/LF warnings on Windows
* text=auto eol=lf

# Binary files should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
*.dll binary
*.so binary

# Scripts should always use LF (they run on Unix-like systems)
*.sh text eol=lf
*.ps1 text eol=crlf

# Config files should use LF
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf