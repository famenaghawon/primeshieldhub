# ============================================================================
# PrimeShieldHub .gitignore
# ============================================================================

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.env
.dev.vars
*.dev.vars
!.dev.vars.example

# Specific key files (no wildcards that could catch source code)
gcp-key.json
service-account-key.json
service-account.json
credentials.json
api-keys.json
apikeys.txt
secrets.json
secrets/
id_rsa
id_ed25519
*.pem
*.pfx
*.crt
*.key

# --- Node.js ---
node_modules/
functions/node_modules/
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Cloudflare ---
.wrangler/
.pages/
/__pages__/
.r2/

# --- Builds ---
dist/
build/
out/
*.tsbuildinfo
*.js.map
*.d.ts.map
.cache/

# --- D1 local DB ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.backup.sql

# --- OS / IDE ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
wrangler.log
wrangler-*.log

# --- Testing / coverage ---
coverage/
.nyc_output/
.vitest/
*.lcov
test-results/

# --- NVM (local Windows Node install) ---
nvm/

# --- Terraform (migrated away) ---
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform-key.json
terraform/backup-*.tfstate
terraform/versions.tf.backup

# --- Application-specific data dumps ---
psh_cart_backup.json
users.json
products.json
resellers.json
reseller_codes.json
settings.json
exports/*.json
!exports/.gitkeep
backend/all-products.json
backend/products-api.json
backend/products-backup.json
db/_schema_raw.json

# --- One-off SQL fix artifacts (canonical schema lives at db/schema.sql, db/seed/*) ---
/*.sql
!schema.sql

# --- Backups / temp ---
backups/
*.bak
*.backup
db-exports/
.temp/
*.tmp
deploy-*.json

# --- Large images (belong in R2, not Git) ---
frontend/public/founder-suit.webp
frontend/public/photograph.webp
frontend/public/ps5.webp
frontend/public/xbox.webp
frontend/public/controller.webp
frontend/public/switch.webp
frontend/public/cac.webp
frontend/public/signature.png
frontend/public/company_logo.png
frontend/public/assets/founder-suit.webp
frontend/public/assets/photograph.webp
frontend/public/assets/images/founder/*.webp
frontend/public/articles/*.webp
frontend/public/fonts/*.zip
frontend/public-backup-rename/
backend/company_logo.png
backend/receipt.png

# --- AI / ML model files ---
*.onnx
*.bin
*.pt
*.h5
*.pkl

# --- Session files ---
*.session
*.jwt
auth-token.txt

# --- Keep placeholders ---
!.env.example
!.dev.vars.example
!exports/.gitkeep
!storage/.gitkeep
!backups/.gitkeep
!migrations/.gitkeep
!scripts/.gitkeep
# Product images belong in R2, not Git
frontend/public/assets/products/
frontend/public/assets/images/founder/
